---
import { getImage } from "astro:assets";
import aboutImage from "../assets/images/site/home/popi-hero-editorial.png";
import aboutImageMobile from "../assets/images/site/home/popi-hero-editorial-mobile.png";
import { withBase } from "../utils/base.js";

const title = "Tizi, Meg e Gea";

const description =
  "Ci piacciono le giornate all'aria aperta, un bel sentiero e le soste per mangiare qualcosa di buono lungo il percorso. La vera protagonista \u00E8 Gea, una border collie di due anni. \u00C8 un piccolo demonio pieno di energia e futura Fetch Queen: ogni prato \u00E8 il suo campo di allenamento.";

const descriptionSecond =
  "Un diario, tre popi e un sacco di avventure.";

const descriptionThird = "";

const [imageMobile, imageDesktop] = await Promise.all([
  getImage({ src: aboutImageMobile, width: 900, format: "webp", quality: 74 }),
  getImage({ src: aboutImage, width: 1440, format: "webp", quality: 78 })
]);

const imageAlt = "Tizi, Meg e Gea in un prato di montagna, accompagnati da segni illustrati colorati.";
---

<section class="about-us" aria-labelledby="about-us-title">
  <div class="about-us__shell">
    <div class="about-us__layout">
      <figure class="about-us__figure">
        <picture>
          <source media="(max-width: 767px)" srcset={imageMobile.src} />
          <img
            src={imageDesktop.src}
            alt={imageAlt}
            width={imageDesktop.attributes.width}
            height={imageDesktop.attributes.height}
            class="about-us__image"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </figure>

      <div class="about-us__content">
        <h2 id="about-us-title" class="about-us__title">Chi sono i popi?</h2>
        <p class="about-us__names">{title}</p>
        <p class="about-us__text">{description}</p>
        <p class="about-us__payoff">{descriptionSecond}</p>
        {descriptionThird && <p class="about-us__text">{descriptionThird}</p>}
        <a class="about-us__link" href={withBase("/gea-gang")}>Scopri tutta la gang</a>
      </div>
    </div>
  </div>

  <!--
    Variante narrativa:

    Siamo Tiz, Meg e Gea: lei &egrave; una border collie giovane, instancabile e con
    una vera passione per il retrieving, quindi ogni camminata diventa anche
    un piccolo allenamento. Non inseguiamo cime estreme: ci bastano sentieri
    accessibili, aria buona e una sosta fatta bene. Questo diario tiene
    insieme le escursioni che ci sono rimaste addosso e quelle giornate
    semplici che finiscono sempre allo stesso modo, stanchi ma felici.
  -->
</section>

<style>
  .about-us__layout {
    display: grid;
    gap: 0;
  }

  .about-us__figure {
    margin: 0;
  }

  .about-us__figure picture {
    display: block;
  }

  .about-us__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    border-radius: 14px;
    background: var(--journal-moss, #91a66d);
  }

  .about-us__content {
    display: flex;
    position: relative;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    margin: -24px 12px 0;
    border-radius: 10px;
    background: var(--journal-paper, #fffdf7);
    padding: 24px;
  }

  .about-us__title {
    margin: 0;
    color: var(--journal-ink, #25251f);
    font-family: "Nunito", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(2rem, 7vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .about-us__names {
    margin: 0;
    color: var(--journal-leaf, #3f6b4f);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .about-us__text {
    margin: 0;
    max-width: 68ch;
    color: var(--journal-ink, #25251f);
    font-size: 1rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .about-us__payoff {
    margin: 2px 0 0;
    max-width: 34ch;
    color: var(--journal-leaf, #3f6b4f);
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.4;
    text-wrap: balance;
  }

  .about-us__link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: 4px;
    border-radius: 10px;
    background: var(--journal-leaf, #3f6b4f);
    padding: 12px 18px;
    color: var(--journal-paper, #fffdf7);
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.3;
    transition: background 180ms ease;
  }

  .about-us__link:hover,
  .about-us__link:focus-visible {
    background: var(--journal-ink, #25251f);
  }

  .about-us__link:focus-visible {
    outline: 3px solid var(--journal-leaf, #3f6b4f);
    outline-offset: 4px;
  }

  @media (min-width: 768px) {
    .about-us__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
      align-items: start;
    }

    .about-us__content {
      margin: 48px 0 0 -48px;
      padding: 32px;
    }

    .about-us__image {
      aspect-ratio: 5 / 4;
      object-position: 72% center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-us__link {
      transition: none;
    }
  }
</style>

