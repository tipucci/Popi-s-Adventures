---
import { withBase } from "../utils/base.js";
import { formatKilometers, formatMeters } from "../utils/format.js";

const { escursione, variant = "secondary" } = Astro.props;
const isFeatured = variant === "featured";
const coverSrc = escursione.coverCard || escursione.cover;
const isPlaceholder = typeof coverSrc === "string" && coverSrc.startsWith("data:image/svg+xml");

function formatDate(value) {
  if (!value) return "Data da definire";
  const parsed = new Date(`${value}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return value;
  return new Intl.DateTimeFormat("it-IT", {
    day: "numeric",
    month: "long",
    year: "numeric"
  }).format(parsed);
}

const metadata = [
  escursione.km > 0 ? `${formatKilometers(escursione.km)} km` : "",
  escursione.dislivello > 0 ? `${formatMeters(escursione.dislivello)} m D+` : "",
  escursione.durata || ""
].filter(Boolean);

const isWithGea = (escursione.partecipanti || []).includes("gea");
---

<article
  class:list={[
    "home-adventure",
    isFeatured ? "home-adventure--featured" : "home-adventure--secondary",
    isPlaceholder && "home-adventure--placeholder"
  ]}
>
  <a
    class="home-adventure__link"
    href={withBase(`/escursioni/${escursione.slug}`)}
    aria-label={`Apri l'avventura ${escursione.titolo}`}
  >
    <figure class="home-adventure__figure">
      <img
        src={coverSrc}
        srcset={escursione.coverSrcSet || undefined}
        sizes={isFeatured ? "(min-width: 960px) 58vw, 100vw" : "(min-width: 640px) 42vw, 100vw"}
        alt={escursione.coverAlt || escursione.titolo}
        width="720"
        height="540"
        loading="lazy"
        decoding="async"
        class="home-adventure__image"
      />
      {isPlaceholder && <span class="home-adventure__placeholder-label">Foto in arrivo</span>}
    </figure>

    <div class="home-adventure__content">
      <h3 class="home-adventure__title">{escursione.titolo}</h3>
      <p class="home-adventure__place-date">
        <span>{escursione.luogo}</span>
        <span aria-hidden="true">·</span>
        <time datetime={escursione.data}>{formatDate(escursione.data)}</time>
      </p>

      {metadata.length > 0 && (
        <p class="home-adventure__metadata" aria-label="Dati dell'escursione">
          {metadata.map((item, index) => (
            <>
              {index > 0 && <span class="home-adventure__separator" aria-hidden="true">·</span>}
              <span>{item}</span>
            </>
          ))}
        </p>
      )}

      {isWithGea && <p class="home-adventure__gea">Con Gea</p>}
      <span class="home-adventure__entry">Apri il ricordo <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<style>
  .home-adventure {
    color: var(--journal-ink, #25251f);
  }

  .home-adventure__link {
    display: block;
    border-radius: 14px;
    outline: none;
  }

  .home-adventure__link:focus-visible {
    outline: 3px solid var(--journal-leaf, #3f6b4f);
    outline-offset: 5px;
  }

  .home-adventure__figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 14px;
    background: var(--journal-paper, #fffdf7);
  }

  .home-adventure--featured .home-adventure__figure {
    aspect-ratio: 16 / 10;
  }

  .home-adventure--secondary .home-adventure__figure {
    aspect-ratio: 16 / 10;
  }

  .home-adventure__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 180ms ease;
  }

  .home-adventure__link:hover .home-adventure__image {
    filter: saturate(1.06);
  }

  .home-adventure__content {
    padding-top: 16px;
  }

  .home-adventure__title {
    margin: 0;
    color: var(--journal-ink, #25251f);
    font-family: "Nunito", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.4rem, 4vw, 1.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    text-wrap: balance;
    transition: color 180ms ease;
  }

  .home-adventure--featured .home-adventure__title {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.08;
  }

  .home-adventure__link:hover .home-adventure__title {
    color: var(--journal-leaf, #3f6b4f);
  }

  .home-adventure__place-date,
  .home-adventure__metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0;
    color: color-mix(in srgb, var(--journal-ink, #25251f) 72%, transparent);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .home-adventure__place-date {
    margin-top: 8px;
  }

  .home-adventure__place-date > span,
  .home-adventure__place-date > time {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .home-adventure__metadata {
    margin-top: 12px;
    color: var(--journal-leaf, #3f6b4f);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .home-adventure__separator {
    color: var(--journal-border, #ddd7c9);
  }

  .home-adventure__gea {
    width: fit-content;
    margin: 12px 0 0;
    border-radius: 9999px;
    background: var(--journal-sunshine, #f2c94c);
    padding: 6px 10px;
    color: var(--journal-ink, #25251f);
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .home-adventure__entry {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    color: var(--journal-leaf, #3f6b4f);
    font-size: 0.9375rem;
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: var(--journal-sunshine, #f2c94c);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .home-adventure__placeholder-label {
    position: absolute;
    inset: auto 12px 12px auto;
    border-radius: 6px;
    background: var(--journal-paper, #fffdf7);
    padding: 6px 10px;
    color: var(--journal-ink, #25251f);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .home-adventure--placeholder .home-adventure__figure {
    aspect-ratio: 16 / 7;
    max-height: 224px;
  }

  .home-adventure--placeholder .home-adventure__image {
    opacity: 0.56;
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .home-adventure--featured.home-adventure--placeholder .home-adventure__figure {
      width: 100%;
      height: 224px;
      max-height: none;
      aspect-ratio: auto;
    }
  }

  @media (min-width: 960px) {
    .home-adventure--featured .home-adventure__link {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
      align-items: center;
      gap: 48px;
    }

    .home-adventure--featured .home-adventure__content {
      padding-top: 0;
    }

    .home-adventure--featured.home-adventure--placeholder .home-adventure__link {
      grid-template-columns: minmax(0, 0.75fr) minmax(19rem, 1.25fr);
    }

    .home-adventure--featured.home-adventure--placeholder .home-adventure__figure {
      aspect-ratio: 4 / 3;
      max-height: 280px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-adventure__image,
    .home-adventure__title {
      transition: none;
    }
  }
</style>
