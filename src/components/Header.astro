---
import { getImage } from "astro:assets";
import { withBase } from "../utils/base.js";
import { siteImages } from "../data/imageRegistry.js";
import curvedArrow from "../assets/images/site/home/curved-arrow.svg";

const {
  title = "Popi's Adventures",
  subtitle = "Un diario, tre popi e un sacco di avventure",
  image = siteImages.heroHome.source,
  imageMobile = null,
  imageDesktop = null,
  imageAlt = siteImages.heroHome.alt,
  latestHref = "#ultima-avventura"
} = Astro.props;

const fallbackSource = image || imageDesktop || imageMobile || siteImages.heroHome.source;
const mobileSource = imageMobile || image || fallbackSource;
const desktopSource = imageDesktop || image || fallbackSource;

const [heroMobile, heroDesktop] = await Promise.all([
  typeof mobileSource === "string"
    ? null
    : getImage({ src: mobileSource, width: 900, format: "webp", quality: 72 }),
  typeof desktopSource === "string"
    ? null
    : getImage({ src: desktopSource, width: 1440, format: "webp", quality: 78 })
]);

const heroFallbackSrc = heroDesktop?.src || heroMobile?.src || siteImages.heroHome.src;
const heroWidth = heroDesktop?.width || heroMobile?.width || 1440;
const heroHeight = heroDesktop?.height || heroMobile?.height || 905;
const curvedArrowSrc = typeof curvedArrow === "string" ? curvedArrow : curvedArrow.src;
---

<section class="hero-journal">
  <div class="hero-journal__media">
    <picture class="hero-journal__picture">
      {heroMobile && <source media="(max-width: 767px)" srcset={heroMobile.src} />}
      {heroDesktop && <source media="(min-width: 768px)" srcset={heroDesktop.src} />}
      <img
        src={heroFallbackSrc}
        alt={imageAlt}
        width={heroWidth}
        height={heroHeight}
        sizes="100vw"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="hero-journal__image"
      />
    </picture>
    <div class="hero-journal__shade"></div>
  </div>

  <div class="hero-journal__body">
    <div class="hero-journal__content">
      <h1>{title}</h1>
      <p>{subtitle}</p>

      <div class="hero-journal__actions">
        <div class="hero-journal__primary-wrap">
          <a href={latestHref} class="hero-journal__primary">Scopri l’ultima avventura</a>
          <img
            src={curvedArrowSrc}
            alt=""
            width="96"
            height="96"
            class="hero-journal__cue"
            aria-hidden="true"
          />
        </div>
        <a href={withBase("/mappa")} class="hero-journal__secondary">Apri la mappa</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-journal {
    position: relative;
    isolation: isolate;
    min-height: 340px;
    overflow: visible;
    border-radius: 14px;
    background: var(--journal-leaf, #3f6b4f);
    color: var(--journal-paper, #fffdf7);
  }

  .hero-journal__media,
  .hero-journal__shade {
    position: absolute;
    inset: 0;
  }

  .hero-journal__media {
    overflow: hidden;
    border-radius: inherit;
  }

  .hero-journal__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-journal__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    transform: scale(1.08);
    transform-origin: left center;
  }

  .hero-journal__shade {
    background: linear-gradient(
      0deg,
      rgba(37, 37, 31, 0.78) 0%,
      rgba(37, 37, 31, 0.4) 48%,
      rgba(37, 37, 31, 0.06) 78%
    );
  }

  .hero-journal__body {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 340px;
    align-items: flex-end;
    padding: 32px 20px;
  }

  .hero-journal__content {
    max-width: 23rem;
  }

  .hero-journal h1 {
    margin: 0;
    color: var(--journal-paper, #fffdf7);
    font-family: "Nunito", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(2.5rem, 10vw, 3.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .hero-journal p {
    max-width: 34rem;
    margin: 12px 0 0;
    color: rgba(255, 253, 247, 0.92);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-journal__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 24px;
  }

  .hero-journal__primary-wrap {
    position: relative;
    display: inline-flex;
  }

  .hero-journal__primary,
  .hero-journal__secondary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .hero-journal__primary {
    border-radius: 10px;
    background: var(--journal-sunshine, #f2c94c);
    padding: 12px 18px;
    color: var(--journal-ink, #25251f);
    transition: background 180ms ease, color 180ms ease;
  }

  .hero-journal__primary:hover {
    background: var(--journal-paper, #fffdf7);
  }

  .hero-journal__secondary {
    color: var(--journal-paper, #fffdf7);
    text-decoration: underline;
    text-decoration-color: rgba(255, 253, 247, 0.5);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .hero-journal__primary:focus-visible,
  .hero-journal__secondary:focus-visible {
    outline: 3px solid var(--journal-sky, #7eb6c2);
    outline-offset: 4px;
  }

  .hero-journal__cue {
    position: absolute;
    z-index: 2;
    top: calc(100% + 8px);
    left: calc(100% - 42px);
    width: 96px;
    height: 96px;
    transform: rotate(-4deg);
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .hero-journal,
    .hero-journal__body {
      min-height: 390px;
    }

    .hero-journal__body {
      padding: 48px 40px;
    }

    .hero-journal__cue {
      top: calc(100% + 18px);
      left: calc(100% - 48px);
      width: 112px;
      height: 112px;
    }
  }

  @media (min-width: 768px) {
    .hero-journal__image {
      object-position: center center;
      transform: none;
    }

    .hero-journal__shade {
      background: linear-gradient(
        90deg,
        rgba(37, 37, 31, 0.66) 0%,
        rgba(37, 37, 31, 0.44) 36%,
        rgba(37, 37, 31, 0.14) 58%,
        rgba(37, 37, 31, 0) 78%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-journal__primary {
      transition: none;
    }
  }
</style>

