---
import "../styles/global.css";
import { withBase } from "../utils/base.js";
import { siteImages } from "../data/imageRegistry.js";
import { ArrowLeft } from "@lucide/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import AppSplash from "../components/AppSplash.astro";
import siteMark from "../assets/images/site/logo/gea-brand-master.png";
import homeNavIcon from "../assets/icons/navigation/home.svg";
import hikesNavIcon from "../assets/icons/navigation/escursioni.svg";
import mapNavIcon from "../assets/icons/navigation/mappa.svg";
import checklistNavIcon from "../assets/icons/navigation/zaino.svg";
import displayFontUrl from "../assets/fonts/alegreya-variable.woff2?url";
import bodyFontUrl from "../assets/fonts/alegreya-sans-regular.woff2?url";

const {
  title = "Popi's Adventures",
  description = "Diario di escursioni tra natura, panorami e camminate con il cane.",
  active = "home",
  image = siteImages.heroHome.src,
  mobileBackHref = "",
  mobileBackLabel = "",
  mobileTitle = ""
} = Astro.props;

const navItems = [
  { id: "home", href: withBase("/"), label: "Home", icon: homeNavIcon, iconRotation: "-1deg" },
  { id: "escursioni", href: withBase("/escursioni"), label: "Escursioni", icon: hikesNavIcon, iconRotation: "1deg" },
  { id: "mappa", href: withBase("/mappa"), label: "Mappa", icon: mapNavIcon, iconRotation: "-1.5deg" },
  { id: "zaino", href: withBase("/prepara-lo-zaino"), label: "Zaino", icon: checklistNavIcon, iconRotation: "1.5deg" }
];

const activeNavItem = navItems.find((item) => item.id === active);
const resolvedMobileTitle = mobileTitle || title.split(" | ")[0] || activeNavItem?.label || "";
const hasMobileHeaderEnd = Astro.slots.has("mobile-header-end");

const footerLinks = [
  { label: "Tutte le escursioni", href: withBase("/escursioni") },
  { label: "Mappa", href: withBase("/mappa") },
  { label: "Gea Gang", href: withBase("/gea-gang") },
  { label: "Prepara lo zaino", href: withBase("/prepara-lo-zaino") }
];

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image.startsWith("http") ? image : new URL(image, Astro.site).href;
const manifestHref = withBase("/manifest.webmanifest");
const appleTouchIconHref = withBase("/icons/apple-touch-icon.png");
const faviconHref = withBase("/favicon-32.png");
const faviconLargeHref = withBase("/favicon.png");
const serviceWorkerUrl = withBase("/sw.js");
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#F7F1E3" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Popi" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href={manifestHref} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconHref} />
    <link rel="icon" type="image/png" sizes="32x32" href={faviconHref} />
    <link rel="icon" type="image/png" sizes="512x512" href={faviconLargeHref} />
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={bodyFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <slot name="head" />
  </head>

  <body class="min-h-screen bg-cream text-forest-800 antialiased">
    <AppSplash />
    <div class="min-h-screen bg-[#F7F1E3]">
      <div class="mx-auto flex min-h-screen w-full max-w-6xl flex-col px-4 pb-[calc(8rem+env(safe-area-inset-bottom))] pt-4 sm:px-6 md:pb-12 lg:px-8">
      <div class="mobile-topbar -mx-4 -mt-4 flex items-center justify-between gap-4 bg-[#F7F1E3] px-4 pb-4 pt-[calc(1rem+env(safe-area-inset-top))] sm:-mx-6 sm:px-6 md:hidden">
        {mobileBackHref && mobileBackLabel ? (
          <a
            href={mobileBackHref}
            class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-[10px] border border-[#DDD7C9] bg-[#FFFDF7] px-3.5 py-2 text-sm font-bold text-[#3F6B4F] transition-colors duration-150 hover:border-[#3F6B4F]/35 hover:bg-[#F2C94C]/20 focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#3F6B4F] motion-reduce:transition-none"
          >
            <ArrowLeft class="h-4 w-4 shrink-0" stroke-width={2.2} aria-hidden="true" />
            <span>{mobileBackLabel}</span>
          </a>
        ) : (
          <a
            href={withBase("/")}
            aria-label="Torna alla home"
            class="inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-[10px] pr-2 transition-colors duration-150 hover:bg-[#FFFDF7] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#3F6B4F] motion-reduce:transition-none"
          >
            <img
              src={siteMark.src}
              alt=""
              width={siteMark.width}
              height={siteMark.height}
              loading="eager"
              decoding="async"
              class="h-12 w-12 object-contain"
            />
            <span class="text-sm font-bold text-[#3F6B4F] sm:text-base">Popi's Adventures</span>
          </a>
        )}

        <div class="min-w-0 flex-1">
          {hasMobileHeaderEnd ? (
            <slot name="mobile-header-end" />
          ) : active !== "home" ? (
            <p class="truncate text-right text-sm font-bold tracking-[0.02em] text-[#3F6B4F]">
              <span class="relative isolate inline-block after:absolute after:-inset-x-0.5 after:-bottom-px after:-z-10 after:h-[5px] after:rotate-[-1deg] after:rounded-[50%] after:bg-[#F2C94C]/75 after:content-['']">
                {resolvedMobileTitle}
              </span>
            </p>
          ) : null}
        </div>
      </div>
        <header class="desktop-header relative isolate z-50 -mt-4 mb-5 hidden border-b border-[#DDD7C9] bg-transparent pb-3 pt-6 font-sans text-[#25251F] before:absolute before:inset-y-0 before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2 before:bg-[#F7F1E3] before:content-[''] md:grid md:grid-cols-[auto_minmax(0,1fr)_auto] md:items-center md:gap-4">
          <a
            href={withBase("/")}
            aria-label="Torna alla home"
            class="inline-flex h-[52px] items-center justify-center gap-2 rounded-[10px] pr-3 transition-colors duration-150 hover:bg-[#FFFDF7] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#3F6B4F] motion-reduce:transition-none"
          >
            <span class="flex h-12 w-12 items-center justify-center">
              <img
                src={siteMark.src}
                alt=""
                width={siteMark.width}
                height={siteMark.height}
                loading="eager"
                decoding="async"
                class="h-12 w-12 object-contain"
              />
            </span>
            <span class="relative isolate text-base font-bold text-[#3F6B4F] after:absolute after:-inset-x-0.5 after:-bottom-px after:-z-10 after:h-[5px] after:rotate-[-1deg] after:rounded-[50%] after:bg-[#F2C94C]/75 after:content-['']">
              Popi's Adventures
            </span>
          </a>

          <div class="min-w-0 px-2">
            <slot name="header-center" />
          </div>

          <nav aria-label="Navigazione principale">
            <ul class="flex items-center gap-1">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={active === item.id ? "page" : undefined}
                    class:list={[
                      "primary-nav-link inline-flex min-h-11 items-center gap-2 rounded-md px-3 py-2.5 text-sm font-bold tracking-[0.02em] transition-colors duration-150 hover:bg-[#FFFDF7] hover:text-[#3F6B4F] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#3F6B4F] motion-reduce:transition-none",
                      active === item.id ? "font-bold !text-[#3F6B4F]" : "text-[#25251F]"
                    ]}
                  >
                    <img
                      src={item.icon.src}
                      alt=""
                      width="24"
                      height="24"
                      aria-hidden="true"
                      class="nav-icon h-5 w-5 shrink-0"
                      style={`--nav-icon-rotation: ${item.iconRotation}`}
                    />
                    <span
                      class:list={[
                        "relative isolate",
                        active === item.id && "after:absolute after:-inset-x-0.5 after:-bottom-px after:-z-10 after:h-[5px] after:rounded-[50%] after:bg-[#F2C94C]/75 after:content-['']"
                      ]}
                    >
                      {item.label}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </header>

        <nav
          aria-label="Navigazione principale"
          class="mobile-bottom-nav fixed inset-x-0 bottom-[calc(1rem+env(safe-area-inset-bottom))] z-[1100] mx-auto w-[calc(100%-2.5rem)] max-w-md rounded-[14px] border border-[#DDD7C9] bg-[#FFFDF7] p-1.5 md:hidden"
        >
          <ul class="grid grid-cols-4 gap-1">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={active === item.id ? "page" : undefined}
                  class:list={[
                    "primary-nav-link relative isolate flex min-h-14 flex-col items-center gap-1 rounded-[10px] px-1 py-2 text-xs font-bold tracking-[0.02em] transition-colors duration-150 focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#3F6B4F] motion-reduce:transition-none",
                    active === item.id
                      ? "font-bold text-[#3F6B4F] after:absolute after:bottom-1 after:left-1/2 after:-z-10 after:h-[5px] after:w-9 after:-translate-x-1/2 after:rotate-[-2deg] after:rounded-[50%] after:bg-[#F2C94C]/80 after:content-['']"
                      : "text-[#25251F]/75 hover:bg-[#F7F1E3] hover:text-[#3F6B4F]"
                  ]}
                >
                  <img
                    src={item.icon.src}
                    alt=""
                    width="24"
                    height="24"
                    aria-hidden="true"
                    class="nav-icon h-[22px] w-[22px] shrink-0"
                    style={`--nav-icon-rotation: ${item.iconRotation}`}
                  />
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <script is:inline>
          const mobileBottomNav = document.querySelector(".mobile-bottom-nav");
          const mobileViewport = window.matchMedia("(max-width: 767px)");

          document.addEventListener("focusin", (event) => {
            const target = event.target;
            if (
              !mobileViewport.matches ||
              !mobileBottomNav ||
              !(target instanceof HTMLElement) ||
              mobileBottomNav.contains(target)
            ) {
              return;
            }

            window.requestAnimationFrame(() => {
              window.requestAnimationFrame(() => {
                if (document.activeElement !== target) return;

                const targetRect = target.getBoundingClientRect();
                const navRect = mobileBottomNav.getBoundingClientRect();
                const overlap = targetRect.bottom - (navRect.top - 16);

                if (overlap > 0) {
                  const root = document.documentElement;
                  const previousScrollBehavior = root.style.scrollBehavior;
                  root.style.scrollBehavior = "auto";
                  window.scrollBy({ top: overlap, left: 0 });
                  root.style.scrollBehavior = previousScrollBehavior;
                }
              });
            });
          });
        </script>

        <main class="flex-1">
          <slot />
        </main>

        <footer class="relative isolate -mx-4 mt-16 border-t border-[#DDD7C9] bg-transparent px-5 py-8 font-sans text-[#25251F] before:absolute before:inset-y-0 before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2 before:bg-[#F7F1E3] before:content-[''] sm:-mx-6 sm:px-6 sm:py-10 lg:-mx-8 lg:px-8">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-8">
            <div class="max-w-xl">
              <p class="text-xl font-bold leading-tight sm:text-2xl">Popi's Adventures</p>
              <p class="mt-3 text-base leading-relaxed text-[#25251F]/80">
                Un diario, tre popi e un sacco di avventure
              </p>
            </div>

            <nav aria-label="Link nel piè di pagina">
              <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
                {footerLinks.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="inline-flex min-h-11 items-center text-sm font-bold !text-[#3F6B4F] underline-offset-4 transition-colors hover:!text-[#25251F] hover:underline focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#3F6B4F] motion-reduce:transition-none"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>

          <div class="mt-6 border-t border-[#DDD7C9] pt-4 text-xs leading-relaxed text-[#25251F]/70 sm:text-sm">
            <p>
              Sviluppato con <span aria-hidden="true">&hearts;</span> e un pizzico di AI da {" "}
              <a
                href="https://tipucci.it"
                target="_blank"
                rel="noreferrer"
                class="font-bold !text-[#3F6B4F] underline-offset-4 transition-colors hover:!text-[#25251F] hover:underline focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#3F6B4F] motion-reduce:transition-none"
              >
                Tiziano Pucci
              </a>
            </p>
          </div>
        </footer>
      </div>

      <SpeedInsights />
      <script is:inline define:vars={{ serviceWorkerUrl }}>
        if ("serviceWorker" in navigator) {
          window.addEventListener("load", () => {
            let refreshing = false;

            navigator.serviceWorker.addEventListener("controllerchange", () => {
              if (refreshing) return;
              refreshing = true;
              window.location.reload();
            });

            navigator.serviceWorker
              .register(serviceWorkerUrl, { updateViaCache: "none" })
              .then((registration) => {
                registration.update();

                registration.addEventListener("updatefound", () => {
                  const worker = registration.installing;
                  if (!worker) return;

                  worker.addEventListener("statechange", () => {
                    if (worker.state === "installed" && navigator.serviceWorker.controller) {
                      worker.postMessage({ type: "SKIP_WAITING" });
                    }
                  });
                });
              })
              .catch(() => {
                // Service worker registration is progressive enhancement.
              });
          });
        }
      </script>
    </div>
  </body>

  <style>
    .nav-icon {
      transform: rotate(var(--nav-icon-rotation, 0deg));
      transform-origin: center;
      transition: transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .primary-nav-link:hover .nav-icon,
    .primary-nav-link[aria-current="page"] .nav-icon {
      transform: rotate(calc(var(--nav-icon-rotation, 0deg) - 2deg)) scale(1.08);
    }

    .primary-nav-link:active .nav-icon {
      transform: rotate(var(--nav-icon-rotation, 0deg)) scale(0.94);
    }

    @media (prefers-reduced-motion: reduce) {
      .nav-icon {
        transition: none;
      }

      .primary-nav-link:hover .nav-icon,
      .primary-nav-link:active .nav-icon,
      .primary-nav-link[aria-current="page"] .nav-icon {
        transform: rotate(var(--nav-icon-rotation, 0deg));
      }
    }
  </style>
</html>
