---
import "../styles/global.css";
import { withBase } from "../utils/base.js";
import { siteImages } from "../data/imageRegistry.js";
import { ArrowLeft, Backpack, Footprints, House, Map } from "@lucide/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import siteLogo from "../assets/images/site/logo/logo-popi.webp";

const {
  title = "Popi's Adventures",
  description = "Diario di escursioni tra natura, panorami e camminate con il cane.",
  active = "home",
  image = siteImages.heroHome.src,
  mobileBackHref = "",
  mobileBackLabel = ""
} = Astro.props;

const navItems = [
  { id: "home", href: withBase("/"), label: "Home", Icon: House },
  { id: "escursioni", href: withBase("/escursioni"), label: "Escursioni", Icon: Footprints },
  { id: "mappa", href: withBase("/mappa"), label: "Mappa", Icon: Map },
  { id: "zaino", href: withBase("/prepara-lo-zaino"), label: "Zaino", Icon: Backpack }
];

const footerLinks = [
  { label: "Tutte le escursioni", href: withBase("/escursioni") },
  { label: "Mappa", href: withBase("/mappa") },
  { label: "Gea Gang", href: withBase("/gea-gang") },
  { label: "Prepara lo zaino", href: withBase("/prepara-lo-zaino") }
];

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image.startsWith("http") ? image : new URL(image, Astro.site).href;
const manifestHref = withBase("/manifest.webmanifest");
const appleTouchIconHref = withBase("/icons/apple-touch-icon-v3.png");
const appleTouchIconFallbackHref = withBase("/apple-touch-icon.png");
const faviconHref = withBase("/favicon-192.png");
const serviceWorkerUrl = withBase("/sw.js");
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#F5EBDC" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Popi" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href={manifestHref} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconHref} />
    <link rel="apple-touch-icon" href={appleTouchIconFallbackHref} />
    <link rel="icon" type="image/png" sizes="192x192" href={faviconHref} />
    <slot name="head" />
  </head>

  <body class="min-h-screen bg-cream text-forest-800 antialiased">
    <div class="min-h-screen bg-hero-glow">
      <div class="mx-auto flex min-h-screen w-full max-w-6xl flex-col px-4 pb-32 pt-4 sm:px-6 md:pb-24 lg:px-8">
      <div class="mobile-topbar mb-4 flex items-center justify-between gap-4 md:hidden">
        <a
          href={withBase("/")}
          aria-label="Torna alla home"
          class="inline-flex items-center justify-center rounded-full p-1 transition"
        >
          <span class="flex h-12 w-12 items-center justify-center">
            <img
              src={siteLogo.src}
              alt="Logo di Popi's Adventures"
              width={siteLogo.width}
              height={siteLogo.height}
              loading="eager"
              decoding="async"
              class="h-12 w-12 object-contain drop-shadow-[0_10px_16px_rgba(95,44,29,0.18)]"
            />
          </span>
        </a>

        {mobileBackHref && mobileBackLabel ? (
          <a
            href={mobileBackHref}
            class="inline-flex items-center justify-center gap-2 rounded-full bg-forest-700 px-4 py-2 text-sm font-bold text-[#fffaf3] shadow-card transition hover:bg-forest-600"
          >
            <ArrowLeft class="h-4 w-4 shrink-0 text-[#fffaf3]" stroke-width={2.2} aria-hidden="true" />
            <span class="text-[#fffaf3]">{mobileBackLabel}</span>
          </a>
        ) : (
          <div class="min-w-0 flex-1">
            <slot name="mobile-header-end" />
          </div>
        )}
      </div>
        <header class="desktop-header z-50 mb-6 hidden border-b border-[#DDD7C9] bg-transparent px-1 pb-3 pt-2 font-sans text-[#25251F] md:grid md:grid-cols-[auto_minmax(0,1fr)_auto] md:items-center md:gap-4">
          <a
            href={withBase("/")}
            aria-label="Torna alla home"
            class="inline-flex h-[52px] w-[52px] items-center justify-center rounded-[10px] transition-colors duration-150 hover:bg-[#FFFDF7] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#F2C94C] motion-reduce:transition-none"
          >
            <span class="flex h-12 w-12 items-center justify-center">
              <img
                src={siteLogo.src}
                alt="Logo di Popi's Adventures"
                width={siteLogo.width}
                height={siteLogo.height}
                loading="eager"
                decoding="async"
                class="h-12 w-12 object-contain"
              />
            </span>
          </a>

          <div class="min-w-0 px-2">
            <slot name="header-center" />
          </div>

          <nav aria-label="Navigazione principale">
            <ul class="flex items-center gap-1">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={active === item.id ? "page" : undefined}
                    class:list={[
                      "inline-flex min-h-11 items-center gap-2 rounded-md px-3 py-2.5 text-sm font-bold tracking-[0.02em] transition-colors duration-150 hover:bg-[#FFFDF7] hover:text-[#3F6B4F] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#F2C94C] motion-reduce:transition-none",
                      active === item.id ? "font-extrabold !text-[#3F6B4F]" : "text-[#25251F]"
                    ]}
                  >
                    <item.Icon class="h-4 w-4 shrink-0" stroke-width={2} aria-hidden="true" />
                    <span
                      class:list={[
                        "relative isolate",
                        active === item.id && "after:absolute after:-inset-x-0.5 after:-bottom-px after:-z-10 after:h-[5px] after:rounded-[50%] after:bg-[#F2C94C]/75 after:content-['']"
                      ]}
                    >
                      {item.label}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </header>

        <main class="flex-1">
          <slot />
        </main>

        <footer class="mt-20 border-t border-[#DDD7C9] py-10 font-sans text-[#25251F] sm:py-12">
          <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-xl">
              <p class="text-xl font-extrabold leading-tight sm:text-2xl">Popi's Adventures</p>
              <p class="mt-3 text-base leading-relaxed text-[#25251F]/80">
                Giornate semplici che ci lasciano con un {" "}
                <span class="relative isolate inline-block font-bold after:absolute after:-inset-x-0.5 after:-bottom-px after:-z-10 after:h-[5px] after:rounded-[50%] after:bg-[#F2C94C]/75 after:content-['']">
                  sorriso
                </span>.
              </p>
            </div>

            <nav aria-label="Link nel piè di pagina">
              <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
                {footerLinks.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="inline-flex min-h-11 items-center text-sm font-bold !text-[#3F6B4F] underline-offset-4 transition-colors hover:!text-[#25251F] hover:underline focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#F2C94C] motion-reduce:transition-none"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>

          <div class="mt-8 border-t border-[#DDD7C9] pt-5 text-xs leading-relaxed text-[#25251F]/70 sm:text-sm">
            <p>
              Sviluppato con <span aria-hidden="true">&hearts;</span> e un pizzico di AI da {" "}
              <a
                href="https://tipucci.it"
                target="_blank"
                rel="noreferrer"
                class="font-bold !text-[#3F6B4F] underline-offset-4 transition-colors hover:!text-[#25251F] hover:underline focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-[#F2C94C] motion-reduce:transition-none"
              >
                Tiziano Pucci
              </a>
            </p>
          </div>
        </footer>
      </div>

      <nav class="mobile-bottom-nav fixed inset-x-0 bottom-4 z-[1100] mx-auto w-[calc(100%-1.5rem)] max-w-md rounded-full border border-white/70 bg-white/90 p-2 shadow-card backdrop-blur md:hidden">
        <ul class="grid grid-cols-4 gap-2">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={active === item.id ? "page" : undefined}
                class:list={[
                  "flex flex-col items-center gap-1 rounded-full px-3 py-2 text-xs font-bold transition",
                  active === item.id
                    ? "bg-terracotta-500 text-[#fffaf3]"
                    : "text-forest-700 hover:bg-terracotta-50"
                ]}
              >
<item.Icon class={active === item.id ? "h-5 w-5 shrink-0 text-[#fffaf3]" : "h-5 w-5 shrink-0"} stroke-width={2} aria-hidden="true" />
                <span class={active === item.id ? "text-[#fffaf3]" : undefined}>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <SpeedInsights />
      <script is:inline define:vars={{ serviceWorkerUrl }}>
        if ("serviceWorker" in navigator) {
          window.addEventListener("load", () => {
            let refreshing = false;

            navigator.serviceWorker.addEventListener("controllerchange", () => {
              if (refreshing) return;
              refreshing = true;
              window.location.reload();
            });

            navigator.serviceWorker
              .register(serviceWorkerUrl, { updateViaCache: "none" })
              .then((registration) => {
                registration.update();

                registration.addEventListener("updatefound", () => {
                  const worker = registration.installing;
                  if (!worker) return;

                  worker.addEventListener("statechange", () => {
                    if (worker.state === "installed" && navigator.serviceWorker.controller) {
                      worker.postMessage({ type: "SKIP_WAITING" });
                    }
                  });
                });
              })
              .catch(() => {
                // Service worker registration is progressive enhancement.
              });
          });
        }
      </script>
    </div>
  </body>
</html>





