---
import Layout from "../layouts/Layout.astro";
import TracceDashboard from "../components/TracceDashboard.jsx";
import { getEscursioni } from "../data/escursioni.js";

const escursioni = await getEscursioni();
const initialArea = Astro.url.searchParams.get("area") || "";
---

<Layout
  title="Dove siamo stati | Popi's Adventures"
  description="Mappa, aree esplorate e giornate da ricordare del nostro diario di escursioni."
  active="mappa"
>
  <TracceDashboard client:load escursioni={escursioni} initialArea={initialArea} />
</Layout>

