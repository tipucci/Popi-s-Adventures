---
import Layout from "../../layouts/Layout.astro";
import Filtri from "../../components/Filtri.jsx";
import SearchEscursioni from "../../components/SearchEscursioni.jsx";
import { getEscursioni } from "../../data/escursioni.js";

const escursioni = await getEscursioni();
const searchParams = Astro.url.searchParams;

const initialFilters = {
  search: searchParams.get("q") || "",
  period: searchParams.get("period") || "",
  kmMin: searchParams.get("kmMin") || "",
  kmMax: searchParams.get("kmMax") || "",
  difficolta: searchParams.get("difficolta") || "",
  stagione: searchParams.get("stagione") || "",
  provincia: searchParams.get("provincia") || searchParams.get("tag") || "",
  soloRifugio: searchParams.get("soloRifugio") === "1",
  soloGea: searchParams.get("soloGea") === "1",
  sort: searchParams.get("sort") || "date-desc",
  page: Number(searchParams.get("page") || "1")
};
---

<Layout
  title="Escursioni | Popi's Adventures"
  description="Elenco filtrabile di tutte le escursioni con ordinamento, paginazione e mappa."
  active="escursioni"
>
  <SearchEscursioni client:load slot="header-center" className="mx-auto w-full max-w-xl" />
  <SearchEscursioni client:load slot="mobile-header-end" className="min-w-0 flex-1" placeholder="Cerca tra le escursioni..." />

  <section class="archive-intro" aria-labelledby="archive-title">
    <h1 id="archive-title">Tutte le nostre avventure</h1>
    <p>
      <span class="archive-intro__count">{escursioni.length} giornate</span>
      da rivivere
    </p>
  </section>

  <Filtri client:load escursioni={escursioni} initialFilters={initialFilters} />
</Layout>

<style>
  .archive-intro {
    display: grid;
    max-width: 46rem;
    gap: 0.75rem;
    margin: 1.5rem 0 2rem;
    color: #25251f;
  }

  .archive-intro h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .archive-intro p {
    max-width: 65ch;
    margin: 0;
    color: #5d5d52;
    font-size: 1rem;
    line-height: 1.7;
  }

  .archive-intro__count {
    position: relative;
    isolation: isolate;
    display: inline-block;
    margin-right: 0.15em;
    color: #25251f;
    font-weight: 800;
  }

  .archive-intro__count::after {
    position: absolute;
    z-index: -1;
    right: -0.12em;
    bottom: 0.08em;
    left: -0.12em;
    height: 0.42em;
    border-radius: 50%;
    background: rgb(242 201 76 / 70%);
    content: "";
  }

  @media (min-width: 40rem) {
    .archive-intro {
      gap: 1rem;
      margin-top: 2rem;
      margin-bottom: 2.5rem;
    }
  }
</style>
