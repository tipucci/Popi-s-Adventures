---
import Layout from "../../layouts/Layout.astro";
import HikeGallery from "../../components/HikeGallery.astro";
import Mappa from "../../components/Mappa.jsx";
import PhotoUploadButton from "../../components/PhotoUploadButton.tsx";
import { ArrowUpRight, Mountain, PawPrint, Star, UserRound } from "@lucide/astro";
import { getDogFriendByName, getDogFriends } from "../../data/dogFriends.js";
import { getEscursioni } from "../../data/escursioni.js";
import { withBase } from "../../utils/base.js";
import { formatKilometers, formatMeters } from "../../utils/format.js";

export async function getStaticPaths() {
  const escursioni = await getEscursioni();
  return escursioni.map((escursione) => ({ params: { slug: escursione.slug }, props: { escursione } }));
}

const { escursione } = Astro.props;
const dogFriends = await getDogFriends();
const compagnia = (Array.isArray(escursione.compagnia) ? escursione.compagnia : []).map((item) => {
  const dogFriend = item.type === "dog" ? getDogFriendByName(item.name, dogFriends) : null;
  return {
    ...item,
    href: dogFriend ? withBase(`/gea-gang/${dogFriend.id}`) : ""
  };
});
const showCompagnia = compagnia.length > 0;

function formatDate(value) {
  if (!value) return "Data da definire";
  const parsed = new Date(`${value}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return value;
  return new Intl.DateTimeFormat("it-IT", { day: "2-digit", month: "short", year: "numeric" }).format(parsed);
}

function formatMetricValue(value, formatter, suffix = "") {
  const numeric = Number(value);
  if (!Number.isFinite(numeric) || numeric <= 0) return "Non disponibile";
  return `${formatter(numeric)}${suffix}`;
}

function formatDurationValue(value) {
  const normalized = String(value || "").trim();
  if (!normalized || normalized === "0" || normalized === "0:00" || normalized === "00:00") {
    return "Non disponibile";
  }

  const clockMatch = normalized.match(/^(\d{1,2}):(\d{2})$/);
  if (clockMatch) {
    const hours = Number(clockMatch[1]);
    const minutes = Number(clockMatch[2]);
    return [hours > 0 ? `${hours} h` : "", minutes > 0 ? `${minutes} min` : ""].filter(Boolean).join(" ");
  }

  return normalized;
}

function getGeaRatingValue(item) {
  const rawCandidates = [item.gea_rating, item.geaRating, item.rating_gea, item.voto];
  const rawValue = rawCandidates.find((candidate) => candidate !== undefined && candidate !== null && candidate !== "");
  const numeric = Number(rawValue);
  if (!Number.isFinite(numeric)) return 0;
  return Math.max(0, Math.min(5, Math.round(numeric * 2) / 2));
}

function hasGea(item) {
  if (item?.cane || item?.gea || item?.con_gea) return true;

  const partecipanti = Array.isArray(item?.partecipanti)
    ? item.partecipanti
    : String(item?.partecipanti || "").split(/[|,;]/);

  return partecipanti.some((participant) => String(participant).trim().toLowerCase() === "gea");
}

const showGeaRating = hasGea(escursione);
const geaRating = getGeaRatingValue(escursione);
const geaStars = Array.from({ length: 5 }, (_, index) => {
  const slot = index + 1;
  if (geaRating >= slot) return "full";
  if (geaRating >= slot - 0.5) return "half";
  return "empty";
});
const heroDescription = String(escursione.note || "").trim();
const hasRealCover = typeof escursione.cover === "string" && !escursione.cover.startsWith("data:image/svg+xml");
const galleryImages = Array.isArray(escursione.gallery) ? escursione.gallery : [];
const jsonLdImages = [escursione.cover, ...galleryImages.map((image) => image.src)]
  .filter((src) => typeof src === "string" && !src.startsWith("data:image/svg+xml"))
  .map((src) => new URL(src, Astro.site).href);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  name: escursione.titolo,
  description: escursione.descrizione,
  image: jsonLdImages,
  url: new URL(withBase(`/escursioni/${escursione.slug}`), Astro.site).href
};
const uploadSlug = escursione.imageSlug || escursione.slug;
---

<Layout title={`${escursione.titolo} | Popi's Adventures`} description={escursione.descrizione} image={escursione.cover} active="escursioni" mobileBackHref={withBase("/escursioni")} mobileBackLabel="Torna indietro">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="hike-journal">
    <header class="hike-hero">
      <div class="hike-hero__intro">
        <h1>{escursione.titolo}</h1>
        <p class="hike-hero__meta">
          <span>{escursione.luogo}</span>
          <span aria-hidden="true">·</span>
          <time datetime={escursione.data}>{formatDate(escursione.data)}</time>
        </p>
        {heroDescription && <p class="hike-hero__description">{heroDescription}</p>}
        <div class="hike-hero__edit">
          <PhotoUploadButton
            client:load
            slug={uploadSlug}
            hikeTitle={escursione.titolo}
            target="cover"
            apiUrl={withBase("/api/admin/upload-hike-photos")}
          />
        </div>
      </div>

      <figure class:list={["hike-hero__figure", !hasRealCover && "hike-hero__figure--placeholder"]}>
        <img
          src={escursione.cover}
          srcset={escursione.coverSrcSet || undefined}
          sizes="(min-width: 900px) 62vw, calc(100vw - 2rem)"
          alt={escursione.coverAlt || escursione.titolo}
          width="960"
          height="720"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        {!hasRealCover && <figcaption>Foto in arrivo</figcaption>}
      </figure>
    </header>

    <section class="hike-facts" aria-label="Dati dell’escursione">
      <dl>
        <div>
          <dt>Distanza</dt>
          <dd>{formatMetricValue(escursione.km, formatKilometers, " km")}</dd>
        </div>
        <div>
          <dt>Durata</dt>
          <dd>{formatDurationValue(escursione.durata)}</dd>
        </div>
        <div>
          <dt>Dislivello</dt>
          <dd>{formatMetricValue(escursione.dislivello, formatMeters, " m D+")}</dd>
        </div>
      </dl>
    </section>

    {(showCompagnia || escursione.nome_rifugio || showGeaRating) && (
      <section class="hike-company" aria-labelledby="hike-company-title">
        <div class="hike-section-heading">
          <h2 id="hike-company-title">La squadra di oggi</h2>
        </div>

        <div class="hike-company__content">
          {showCompagnia && (
            <div class="hike-company__cluster hike-company__cluster--people">
              <p class="hike-company__label">Con noi</p>
              <ul class="hike-company__people" aria-label="Compagnia dell’escursione">
                {compagnia.map((item) => (
                  <li>
                    {item.href ? (
                      <a href={item.href} aria-label={`Apri il profilo di ${item.name}`}>
                        {item.type === "dog" ? (
                          <PawPrint size={18} strokeWidth={2.2} aria-hidden="true" />
                        ) : (
                          <UserRound size={18} strokeWidth={2.2} aria-hidden="true" />
                        )}
                        <span>{item.name}</span>
                        <ArrowUpRight class="hike-company__profile-cue" size={15} strokeWidth={2.2} aria-hidden="true" />
                      </a>
                    ) : (
                      <span>
                        {item.type === "dog" ? (
                          <PawPrint size={18} strokeWidth={2.2} aria-hidden="true" />
                        ) : (
                          <UserRound size={18} strokeWidth={2.2} aria-hidden="true" />
                        )}
                        <span>{item.name}</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {escursione.nome_rifugio && (
            <div class="hike-company__cluster hike-company__cluster--refuge">
              <p class="hike-company__label">Tappa</p>
              <div class="hike-refuge">
                <span class="hike-refuge__marker" aria-hidden="true">
                  <Mountain size={22} strokeWidth={2.2} />
                </span>
                <strong>{escursione.nome_rifugio}</strong>
              </div>
            </div>
          )}

          {showGeaRating && (
            <div class="hike-gea-rating">
              <div class="hike-gea-rating__heading">
                <span class="hike-gea-rating__badge" aria-hidden="true">
                  <PawPrint size={18} strokeWidth={2.2} />
                </span>
                <p>Il voto di Gea</p>
              </div>
              <div class="hike-gea-rating__row" aria-label={`Il voto di Gea: ${geaRating} su 5`}>
                <span class="hike-gea-rating__stars" aria-hidden="true">
                  {geaStars.map((starType) => (
                    starType === "full" ? (
                      <Star size={28} strokeWidth={2} class="fill-current" />
                    ) : starType === "half" ? (
                      <span class="relative inline-flex h-7 w-7 shrink-0">
                        <Star size={28} strokeWidth={2} class="absolute inset-0 hike-gea-rating__empty" />
                        <span class="absolute inset-y-0 left-0 w-1/2 overflow-hidden">
                          <Star size={28} strokeWidth={2} class="absolute inset-y-0 left-0 max-w-none fill-current" />
                        </span>
                      </span>
                    ) : (
                      <Star size={28} strokeWidth={2} class="hike-gea-rating__empty" />
                    )
                  ))}
                </span>
                <strong><span>{geaRating}</span><small>/5</small></strong>
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <section class="hike-route" aria-labelledby="hike-route-title">
      <div class="hike-section-heading">
        <h2 id="hike-route-title">Dove siamo stati</h2>
      </div>
      <div class="hike-route__map">
        <Mappa
          client:load
          escursioni={[escursione]}
          height="clamp(260px, 42vw, 280px)"
          title={`Posizione di ${escursione.titolo}`}
          showHeader={false}
          variant="journal"
        />
      </div>
    </section>

    <HikeGallery images={galleryImages}>
      <PhotoUploadButton
        slot="footer"
        client:load
        slug={uploadSlug}
        hikeTitle={escursione.titolo}
        target="gallery"
        apiUrl={withBase("/api/admin/upload-hike-photos")}
      />
    </HikeGallery>
  </article>
</Layout>

<style>
  .hike-journal {
    --journal-paper: #fffdf7;
    --journal-ink: #25251f;
    --journal-leaf: #3f6b4f;
    --journal-sunshine: #f2c94c;
    --journal-tomato: #e66a4e;
    --journal-moss: #91a66d;
    --journal-border: #ddd7c9;

    color: var(--journal-ink);
  }

  .hike-hero {
    display: grid;
    gap: 28px;
  }

  .hike-hero__intro {
    align-self: center;
    min-width: 0;
  }

  .hike-hero h1,
  .hike-section-heading h2 {
    margin: 0;
    color: var(--journal-ink);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: var(--type-tracking-display);
    text-wrap: balance;
  }

  .hike-hero h1 {
    width: fit-content;
    max-width: min(100%, 12ch);
    font-size: var(--type-page-title);
    line-height: var(--type-leading-page-title);
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .hike-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 9px;
    margin: 12px 0 0;
    color: color-mix(in srgb, var(--journal-ink) 70%, transparent);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .hike-hero__description {
    max-width: 68ch;
    margin: 20px 0 0;
    color: color-mix(in srgb, var(--journal-ink) 84%, transparent);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hike-hero__edit {
    margin-top: 12px;
  }

  .hike-hero__figure {
    position: relative;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border-radius: 14px;
    background: var(--journal-paper);
    aspect-ratio: 4 / 3;
  }

  .hike-hero__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hike-hero__figure figcaption {
    position: absolute;
    right: 12px;
    bottom: 12px;
    border-radius: 6px;
    background: var(--journal-paper);
    padding: 6px 10px;
    color: var(--journal-ink);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .hike-hero__figure--placeholder img {
    opacity: 0.58;
  }

  .hike-facts {
    margin-top: 40px;
    border-block: 1px solid var(--journal-border);
    padding-block: 20px;
  }

  .hike-facts dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
  }

  .hike-facts dl > div {
    min-width: 0;
  }

  .hike-facts dt,
  .hike-facts dd {
    margin: 0;
  }

  .hike-facts dt,
  .hike-company__label {
    color: color-mix(in srgb, var(--journal-ink) 70%, transparent);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .hike-facts dd {
    margin-top: 5px;
    color: var(--journal-leaf);
    font-size: clamp(1rem, 4.2vw, 1.25rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .hike-company,
  .hike-route,
  :global(.hike-gallery) {
    margin-top: 64px;
  }

  .hike-section-heading h2 {
    font-size: var(--type-section-title);
    line-height: var(--type-leading-section-title);
  }

  .hike-section-heading > p {
    max-width: 68ch;
    margin: 10px 0 0;
    color: color-mix(in srgb, var(--journal-ink) 68%, transparent);
    line-height: 1.65;
  }

  .hike-company__content {
    display: grid;
    gap: 24px;
    margin-top: 28px;
    border-block: 1px solid var(--journal-border);
    padding-block: 24px;
  }

  .hike-company__cluster {
    min-width: 0;
  }

  .hike-company__label {
    margin: 0 0 10px;
  }

  .hike-company__people {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hike-company__people a,
  .hike-company__people li > span {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 9px;
    border-radius: 9999px;
    background: var(--journal-paper);
    padding: 10px 14px;
    color: var(--journal-leaf);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .hike-company__people a {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--journal-leaf) 26%, transparent);
    outline: none;
    transition: color 160ms ease, background 160ms ease;
  }

  .hike-company__people a:hover {
    background: color-mix(in srgb, var(--journal-moss) 18%, var(--journal-paper));
    color: var(--journal-ink);
  }

  .hike-company__people a:focus-visible {
    outline: 3px solid var(--journal-leaf);
    outline-offset: 3px;
  }

  .hike-company__profile-cue {
    flex: 0 0 auto;
    color: color-mix(in srgb, var(--journal-leaf) 72%, transparent);
  }

  .hike-refuge {
    display: grid;
    width: fit-content;
    max-width: 100%;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
  }

  .hike-refuge__marker {
    position: relative;
    isolation: isolate;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    color: var(--journal-leaf);
  }

  .hike-refuge__marker::before {
    position: absolute;
    inset: 3px;
    z-index: -1;
    border-radius: 48% 52% 44% 56%;
    background: color-mix(in srgb, var(--journal-sunshine) 44%, transparent);
    transform: rotate(-6deg);
    content: "";
  }

  .hike-refuge strong {
    display: block;
    margin: 0;
    color: var(--journal-ink);
    font-size: 1.25rem;
    line-height: 1.35;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .hike-refuge > strong {
    width: fit-content;
    max-width: 100%;
    margin-top: 0;
  }

  .hike-gea-rating {
    width: min(100%, 22rem);
    border: 1px solid color-mix(in srgb, var(--journal-leaf) 18%, var(--journal-border));
    border-radius: 14px;
    background: color-mix(in srgb, var(--journal-sunshine) 13%, var(--journal-paper));
    padding: 14px 16px 16px;
  }

  .hike-gea-rating__heading {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hike-gea-rating__badge {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 10px;
    background: var(--journal-sunshine);
    color: var(--journal-leaf);
    transform: rotate(-3deg);
  }

  .hike-gea-rating__heading p {
    margin: 0;
    color: var(--journal-ink);
    font-size: 1rem;
    line-height: 1.25;
  }

  .hike-gea-rating__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 12px;
  }

  .hike-gea-rating__stars {
    display: inline-flex;
    gap: 4px;
    color: var(--journal-tomato);
  }

  .hike-gea-rating__empty {
    color: color-mix(in srgb, var(--journal-ink) 22%, transparent);
  }

  .hike-gea-rating__row strong {
    margin: 0;
    color: var(--journal-ink);
    font-size: 1.25rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    white-space: nowrap;
  }

  .hike-gea-rating__row small {
    margin-left: 2px;
    color: color-mix(in srgb, var(--journal-ink) 62%, transparent);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .hike-route__map {
    max-width: 52rem;
    margin-top: 24px;
  }

  .hike-route :global(.leaflet-host--journal .leaflet-control-zoom) {
    border: 1px solid color-mix(in srgb, var(--journal-leaf) 24%, var(--journal-border));
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(37, 37, 31, 0.08);
  }

  .hike-route :global(.leaflet-host--journal .leaflet-control-attribution) {
    border-radius: 6px 0 0 0;
    background: color-mix(in srgb, var(--journal-paper) 92%, transparent);
    padding: 2px 5px;
  }

  @media (max-width: 419px) {
    .hike-facts dl {
      gap: 12px;
    }
  }

  @media (min-width: 640px) {
    .hike-facts {
      margin-top: 48px;
      padding-block: 24px;
    }

    .hike-facts dl {
      gap: 24px;
    }

    .hike-company__content {
      grid-template-columns: minmax(0, 0.85fr) minmax(17rem, 1.15fr);
      align-items: start;
    }

    .hike-company__cluster--people {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 900px) {
    .hike-hero {
      grid-template-columns: minmax(17rem, 0.72fr) minmax(0, 1.28fr);
      align-items: center;
      gap: 56px;
      min-height: 480px;
    }

    .hike-company,
    .hike-route,
    :global(.hike-gallery) {
      margin-top: 96px;
    }

    .hike-company__content {
      grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
      align-items: end;
      gap: 32px;
    }

    .hike-company__cluster--people {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hike-company__people a {
      transition: none;
    }
  }
</style>


