---
import Layout from "../../layouts/Layout.astro";
import { getImage } from "astro:assets";
import { PawPrint } from "@lucide/astro";
import { getDogFriendById, getDogFriendImage, getDogFriends, slugifyDogName } from "../../data/dogFriends.js";
import { getEscursioni } from "../../data/escursioni.js";
import { withBase } from "../../utils/base.js";

export async function getStaticPaths() {
  const dogs = await getDogFriends();
  return dogs.map((dog) => ({
    params: { id: dog.id }
  }));
}

const dogs = await getDogFriends();
const dog = getDogFriendById(Astro.params.id, dogs);

if (!dog) {
  throw new Response(null, { status: 404, statusText: "Dog friend not found" });
}

const dogImage = getDogFriendImage(dog.image);
const dogImageSources = dogImage
  ? await Promise.all(
      [480, 768, 1200].map(async (width) => {
        const source = await getImage({
          src: dogImage,
          width,
          format: "webp",
          quality: width === 1200 ? 78 : 74
        });

        return { ...source, width };
      })
    )
  : [];
const dogImageSrc = dogImageSources[1]?.src || dogImageSources[0]?.src || dogImage?.src || "";
const dogImageSrcSet = dogImageSources.map((source) => `${source.src} ${source.width}w`).join(", ");
const dogTraits = Array.isArray(dog.traits) ? dog.traits.filter(Boolean) : [];
const otherDogs = dogs.filter((member) => member.id !== dog.id);
const escursioni = await getEscursioni();
const recentHikes = escursioni
  .filter((item) =>
    Array.isArray(item.compagnia) &&
    item.compagnia.some((member) => member.type === "dog" && slugifyDogName(member.name) === dog.id)
  )
  .slice(0, 4);

function formatDate(value) {
  if (!value) return "";
  const parsed = new Date(`${value}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return value;
  return new Intl.DateTimeFormat("it-IT", { day: "2-digit", month: "long", year: "numeric" }).format(parsed);
}
---

<Layout
  title={`${dog.name} | Gea Gang`}
  description={dog.description || `${dog.name}, Gea Gang.`}
  active="gea-gang"
  mobileBackHref={withBase("/gea-gang")}
  mobileBackLabel="Torna alla gang"
>
  <article class="dog-detail">
    <svg class="dog-detail__trail" viewBox="0 0 1000 760" preserveAspectRatio="none" aria-hidden="true">
      <path d="M765 5 C 940 145, 850 285, 610 350 S 245 505, 315 755" pathLength="1" />
    </svg>

    <section class:list={["dog-profile", `dog-profile--${dog.id}`, { "dog-profile--no-image": !dogImage }]}>
      <div class="dog-profile__media">
        {dogImage ? (
          <img
            src={dogImageSrc}
            srcset={dogImageSrcSet}
            sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1023px) calc(100vw - 48px), 58vw"
            alt={dog.breed ? `${dog.name}, ${dog.breed}.` : dog.name}
            width={dogImage.width}
            height={dogImage.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="dog-profile__portrait"
          />
        ) : (
          <div class="dog-profile__placeholder">
            <div>
              <span>
                <PawPrint size={34} strokeWidth={2.2} aria-hidden="true" />
              </span>
              <p>Ritratto in arrivo</p>
            </div>
          </div>
        )}
      </div>

      <div class="dog-profile__content">
        <header>
          <nav class="dog-profile__breadcrumb" aria-label="Percorso">
            <ol>
              <li><a href={withBase("/gea-gang")}>Gea Gang</a></li>
              <li aria-current="page">{dog.name}</li>
            </ol>
          </nav>
          <h1>{dog.name}</h1>
          {dog.breed && <p class="dog-profile__breed">{dog.breed}</p>}
        </header>

        {dog.description && <p class="dog-profile__description">{dog.description}</p>}

        {(dog.weightKg || dog.birthDate) && (
          <dl class="dog-profile__facts">
            {dog.weightKg && (
              <div>
                <dt>Peso</dt>
                <dd>{dog.weightKg} kg</dd>
              </div>
            )}

            {dog.birthDate && (
              <div>
                <dt>Nascita</dt>
                <dd>{formatDate(dog.birthDate)}</dd>
              </div>
            )}
          </dl>
        )}

        {dogTraits.length > 0 && (
          <ul class="dog-profile__traits" aria-label={`Tratti di ${dog.name}`} role="list">
            {dogTraits.map((trait) => (
              <li>{trait}</li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <section class="dog-adventures">
      <h2>Ultime avventure con <span>{dog.name}</span></h2>

      {recentHikes.length > 0 ? (
        <div class="dog-adventures__grid">
          {recentHikes.map((hike) => (
            <a
              href={withBase(`/escursioni/${hike.slug}`)}
              class="dog-adventure"
            >
              <img
                src={hike.coverCard || hike.cover}
                alt={hike.coverAlt}
                loading="lazy"
                decoding="async"
              />
              <div>
                <p class="dog-adventure__date">{formatDate(hike.data)}</p>
                <h3>{hike.titolo}</h3>
                <p class="dog-adventure__place">{hike.luogo}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="dog-adventures__empty">
          <p>Le avventure di {dog.name} devono ancora entrare nel diario.</p>
          <a href={withBase("/escursioni")}>Esplora il diario</a>
        </div>
      )}
    </section>

    {otherDogs.length > 0 && (
      <nav class="dog-handoff" aria-labelledby={`dog-handoff-${dog.id}`}>
        <div>
          <h2 id={`dog-handoff-${dog.id}`}>La gang continua</h2>
          <a href={withBase("/gea-gang")} class="dog-handoff__all">Tutta la Gea Gang</a>
        </div>

        <ul role="list">
          {otherDogs.map((member) => (
            <li><a href={withBase(`/gea-gang/${member.id}`)}>{member.name}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</Layout>

<style>
  .dog-detail {
    --dog-cream: #f7f1e3;
    --dog-paper: #fffdf7;
    --dog-ink: #25251f;
    --dog-leaf: #3f6b4f;
    --dog-sunshine: #f2c94c;
    --dog-tomato: #e66a4e;
    --dog-border: #ddd7c9;

    position: relative;
    isolation: isolate;
    color: var(--dog-ink);
  }

  .dog-detail ::selection {
    background: color-mix(in srgb, var(--dog-sunshine) 72%, transparent);
    color: var(--dog-ink);
  }

  .dog-detail__trail {
    display: none;
  }

  .dog-profile {
    display: grid;
    gap: 32px;
  }

  .dog-profile__media {
    position: relative;
    overflow: hidden;
    min-height: 0;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    background: var(--dog-cream);
  }

  .dog-profile__portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      filter 220ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dog-profile--gea .dog-profile__portrait {
    object-position: center 42%;
  }

  .dog-profile--luffy .dog-profile__portrait {
    object-position: 58% center;
  }

  .dog-profile__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at top, color-mix(in srgb, var(--dog-paper) 70%, transparent), transparent 58%),
      linear-gradient(135deg, var(--dog-cream), var(--dog-border));
    color: var(--dog-ink);
    text-align: center;
  }

  .dog-profile__placeholder::before {
    position: absolute;
    width: min(72%, 25rem);
    height: 62%;
    border: 2px dashed color-mix(in srgb, var(--dog-tomato) 38%, transparent);
    border-radius: 50%;
    content: "";
    transform: rotate(-7deg);
  }

  .dog-profile__placeholder > div {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px;
  }

  .dog-profile__placeholder span {
    display: grid;
    width: 60px;
    height: 60px;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--dog-sunshine) 30%, var(--dog-paper));
  }

  .dog-profile__placeholder p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: var(--type-tracking-display);
  }

  .dog-profile--no-image .dog-profile__media {
    grid-row: 2;
    aspect-ratio: 16 / 7;
  }

  .dog-profile--no-image .dog-profile__content {
    grid-row: 1;
  }

  .dog-profile__content {
    align-self: center;
    min-width: 0;
  }

  .dog-profile__breadcrumb {
    display: none;
    margin-bottom: 32px;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .dog-profile__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dog-profile__breadcrumb li + li::before {
    margin-right: 8px;
    color: var(--dog-tomato);
    content: "/";
  }

  .dog-profile__breadcrumb a {
    min-height: 44px;
    color: var(--dog-leaf);
    line-height: 44px;
  }

  .dog-profile__breadcrumb [aria-current="page"] {
    color: color-mix(in srgb, var(--dog-ink) 72%, transparent);
  }

  .dog-profile__breadcrumb a,
  .dog-adventures__empty a,
  .dog-handoff__all {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--dog-leaf) 38%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .dog-profile h1 {
    width: fit-content;
    margin: 0;
    color: var(--dog-ink);
    font-family: var(--font-display);
    font-size: var(--type-page-title);
    font-weight: 600;
    letter-spacing: var(--type-tracking-display);
    line-height: var(--type-leading-page-title);
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .dog-profile__breed {
    margin: 10px 0 0;
    color: var(--dog-leaf);
    font-size: 1rem;
    font-weight: 700;
  }

  .dog-profile__description {
    max-width: 65ch;
    margin: 28px 0 0;
    color: color-mix(in srgb, var(--dog-ink) 84%, transparent);
    font-size: 1rem;
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  .dog-profile__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: 28px 0 0;
    border-block: 1px solid var(--dog-border);
    padding-block: 14px;
  }

  .dog-profile__facts > div {
    display: flex;
    align-items: baseline;
    min-width: 0;
    gap: 8px;
  }

  .dog-profile__facts dt,
  .dog-adventure__date {
    color: var(--dog-tomato);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .dog-profile__facts dd {
    margin: 0;
    color: var(--dog-ink);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .dog-profile__traits {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin: 18px 0 0;
    padding: 0;
    color: var(--dog-leaf);
    font-size: 0.875rem;
    font-weight: 700;
    list-style: none;
  }

  .dog-profile__traits li:not(:last-child)::after {
    margin-left: 12px;
    color: var(--dog-tomato);
    content: "·";
  }

  .dog-adventures {
    margin-top: 96px;
  }

  .dog-adventures > h2 {
    max-width: 16ch;
    margin: 0;
    color: var(--dog-ink);
    font-family: var(--font-display);
    font-size: var(--type-section-title);
    font-weight: 600;
    letter-spacing: var(--type-tracking-display);
    line-height: var(--type-leading-section-title);
    text-wrap: balance;
  }

  .dog-adventures > h2 span {
    color: var(--dog-leaf);
  }

  .dog-adventures__grid {
    display: grid;
    gap: 56px;
    margin-top: 40px;
  }

  .dog-adventures__empty {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: 40px;
    border-block: 1px solid var(--dog-border);
    padding-block: 24px;
  }

  .dog-adventures__empty p {
    max-width: 44ch;
    margin: 0;
    color: color-mix(in srgb, var(--dog-ink) 78%, transparent);
    line-height: 1.65;
  }

  .dog-adventures__empty a {
    min-height: 44px;
    color: var(--dog-leaf);
    font-weight: 700;
    line-height: 44px;
  }

  .dog-adventure {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .dog-adventure > img {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    object-fit: cover;
    transition:
      filter 220ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dog-adventure > div {
    padding-top: 18px;
  }

  .dog-adventure__date,
  .dog-adventure__place {
    margin: 0;
  }

  .dog-adventure h3 {
    margin: 8px 0 0;
    color: var(--dog-ink);
    font-family: var(--font-display);
    font-size: var(--type-card-title);
    font-weight: 600;
    line-height: var(--type-leading-card-title);
    letter-spacing: var(--type-tracking-display);
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .dog-adventure__place {
    margin-top: 5px;
    color: color-mix(in srgb, var(--dog-ink) 70%, transparent);
    font-size: 0.875rem;
  }

  .dog-handoff {
    display: grid;
    gap: 28px;
    margin-top: 96px;
    border-top: 1px solid var(--dog-border);
    padding-top: 32px;
  }

  .dog-handoff h2 {
    margin: 0;
    color: var(--dog-ink);
    font-family: var(--font-display);
    font-size: var(--type-subsection-title);
    font-weight: 600;
    line-height: var(--type-leading-subsection-title);
    letter-spacing: var(--type-tracking-display);
  }

  .dog-handoff__all {
    display: inline-block;
    min-height: 44px;
    margin-top: 8px;
    color: var(--dog-leaf);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 44px;
  }

  .dog-handoff ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dog-handoff li {
    min-width: 0;
  }

  .dog-handoff li a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--dog-leaf);
    font-family: var(--font-display);
    font-size: var(--type-card-title);
    font-weight: 600;
    line-height: var(--type-leading-card-title);
    letter-spacing: var(--type-tracking-display);
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .dog-profile__breadcrumb a:focus-visible,
  .dog-adventures__empty a:focus-visible,
  .dog-handoff a:focus-visible,
  .dog-adventure:focus-visible {
    outline: 3px solid var(--dog-leaf);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .dog-profile__breadcrumb a:hover,
    .dog-handoff a:hover {
      color: var(--dog-ink);
      text-decoration-color: currentColor;
    }

    .dog-adventures__empty a:hover {
      color: var(--dog-ink);
      text-decoration-color: currentColor;
    }

    .dog-adventure:hover > img {
      filter: saturate(1.05);
      transform: scale(1.018);
    }
  }

  @media (min-width: 768px) {
    .dog-profile__breadcrumb {
      display: block;
    }

    .dog-adventures__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 64px 32px;
    }

    .dog-adventure:nth-child(even) {
      margin-top: 64px;
    }

    .dog-handoff {
      grid-template-columns: minmax(12rem, 0.75fr) minmax(0, 1.25fr);
      align-items: start;
    }
  }

  @media (min-width: 1024px) {
    .dog-detail__trail {
      position: absolute;
      top: 360px;
      right: 6%;
      z-index: -1;
      display: block;
      width: 72%;
      height: 760px;
      overflow: visible;
      pointer-events: none;
    }

    .dog-detail__trail path {
      fill: none;
      stroke: color-mix(in srgb, var(--dog-tomato) 42%, transparent);
      stroke-dasharray: 0.012 0.018;
      stroke-linecap: round;
      stroke-width: 3;
      vector-effect: non-scaling-stroke;
    }

    .dog-profile {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 48px 32px;
      align-items: center;
    }

    .dog-profile__media {
      grid-column: 1 / span 7;
      min-height: 39rem;
      aspect-ratio: auto;
    }

    .dog-profile__content {
      grid-column: 8 / span 5;
      margin-top: 72px;
      padding-right: clamp(0px, 2vw, 24px);
    }

    .dog-profile--no-image .dog-profile__media {
      grid-column: 8 / span 5;
      grid-row: 1;
      min-height: 24rem;
      aspect-ratio: auto;
    }

    .dog-profile--no-image .dog-profile__content {
      grid-column: 1 / span 6;
      grid-row: 1;
      margin-top: 0;
      padding-right: 0;
    }

    .dog-adventures__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 72px 32px;
    }

    .dog-adventure:nth-child(4n + 1) {
      grid-column: 1 / span 7;
    }

    .dog-adventure:nth-child(4n + 2) {
      grid-column: 9 / span 4;
      margin-top: 96px;
    }

    .dog-adventure:nth-child(4n + 3) {
      grid-column: 1 / span 4;
      margin-top: 0;
    }

    .dog-adventure:nth-child(4n + 4) {
      grid-column: 6 / span 7;
      margin-top: 72px;
    }

    .dog-adventure:nth-child(4n + 2) > img,
    .dog-adventure:nth-child(4n + 3) > img {
      aspect-ratio: 4 / 5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dog-profile__portrait,
    .dog-adventure > img {
      transition: none;
    }

    .dog-adventure:hover > img {
      transform: none;
    }
  }
</style>
