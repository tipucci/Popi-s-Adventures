---
import { getImage } from "astro:assets";
import { PawPrint } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import { getDogFriendImage, getDogFriends } from "../data/dogFriends.js";
import { withBase } from "../utils/base.js";

async function createDogImageSources(imageAsset) {
  if (!imageAsset) return [];

  return Promise.all(
    [480, 768, 1200].map(async (width) => {
      const source = await getImage({
        src: imageAsset,
        width,
        format: "webp",
        quality: width === 1200 ? 78 : 74
      });

      return { ...source, width };
    })
  );
}

const dogs = await Promise.all(
  (await getDogFriends()).map(async (dog) => {
    const imageAsset = getDogFriendImage(dog.image);
    const imageSources = await createDogImageSources(imageAsset);

    return {
      ...dog,
      imageAsset,
      imageSources,
      imageSrc: imageSources[1]?.src || imageSources[0]?.src || imageAsset?.src || "",
      imageSrcSet: imageSources.map((source) => `${source.src} ${source.width}w`).join(", ")
    };
  })
);

function getDogAgeLabel(value) {
  if (!value) return "";
  const birthDate = new Date(`${value}T00:00:00`);
  if (Number.isNaN(birthDate.getTime())) return "";

  const now = new Date();
  let years = now.getFullYear() - birthDate.getFullYear();
  const monthDelta = now.getMonth() - birthDate.getMonth();
  const dayDelta = now.getDate() - birthDate.getDate();

  if (monthDelta < 0 || (monthDelta === 0 && dayDelta < 0)) {
    years -= 1;
  }

  if (years <= 0) return "meno di 1 anno";
  return `${years} ${years === 1 ? "anno" : "anni"}`;
}

function getDogFacts(dog) {
  return [
    getDogAgeLabel(dog.birthDate),
    dog.weightKg ? `${dog.weightKg} kg` : ""
  ].filter(Boolean);
}

const homeHref = withBase("/");
---

<Layout
  title="Gea Gang | Popi's Adventures"
  description="Gea, Luffy, Zeus e Ariel."
  active="gea-gang"
  mobileBackHref={homeHref}
  mobileBackLabel="Torna alla home"
  mobileTitle="Gea Gang"
>
  <article class="gang-page" aria-labelledby="gang-title">
    <header class="gang-intro">
      <nav class="gang-breadcrumb" aria-label="Percorso">
        <a href={homeHref}>Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Gea Gang</span>
      </nav>

      <h1 id="gang-title">Gea <span>Gang</span></h1>
    </header>

    {dogs.length > 0 ? (
      <>
        <svg
          class="gang-route"
          viewBox="0 0 1000 1240"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M620 5 C 930 150, 950 340, 730 470 S 195 650, 215 845 S 605 1045, 920 1235"
            pathLength="1"
          />
        </svg>

        <ul class="gang-grid" role="list">
          {dogs.map((dog, index) => {
            const facts = getDogFacts(dog);

            return (
              <li class:list={["gang-member", `gang-member--${(index % 4) + 1}`]}>
                <a
                  href={withBase(`/gea-gang/${dog.id}`)}
                  class="gang-member__link"
                  aria-label={`Leggi il profilo di ${dog.name}`}
                >
                  <figure>
                    <div class="gang-member__portrait">
                      {dog.imageAsset ? (
                        <img
                          src={dog.imageSrc}
                          srcset={dog.imageSrcSet}
                          sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1023px) 46vw, 58vw"
                          alt={dog.breed ? `${dog.name}, ${dog.breed}.` : dog.name}
                          width={dog.imageAsset.width}
                          height={dog.imageAsset.height}
                          loading={index === 0 ? "eager" : "lazy"}
                          fetchpriority={index === 0 ? "high" : "auto"}
                          decoding="async"
                        />
                      ) : (
                        <div class="gang-member__placeholder">
                          <PawPrint size={34} strokeWidth={1.9} aria-hidden="true" />
                          <span>Foto di {dog.name} non disponibile</span>
                        </div>
                      )}
                    </div>

                    <figcaption class="gang-member__body">
                      <div class="gang-member__identity">
                        <h2>{dog.name}</h2>
                        {dog.breed && <p>{dog.breed}</p>}
                      </div>

                      {facts.length > 0 && (
                        <p class="gang-member__facts" aria-label={`Informazioni su ${dog.name}: ${facts.join(", ")}`}>
                          {facts.join(" · ")}
                        </p>
                      )}

                      <p class="gang-member__description">{dog.description}</p>
                    </figcaption>
                  </figure>
                </a>
              </li>
            );
          })}
        </ul>
      </>
    ) : (
      <section class="gang-empty" aria-labelledby="gang-empty-title">
        <PawPrint size={34} strokeWidth={1.9} aria-hidden="true" />
        <h2 id="gang-empty-title">Nessun profilo disponibile</h2>
        <p>Riprova tra poco oppure torna alla home.</p>
        <div class="gang-empty__actions">
          <a href={Astro.url.pathname}>Riprova</a>
          <a href={homeHref}>Torna alla home</a>
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .gang-page {
    --gang-cream: #f7f1e3;
    --gang-paper: #fffdf7;
    --gang-ink: #25251f;
    --gang-leaf: #3f6b4f;
    --gang-sunshine: #f2c94c;
    --gang-tomato: #e66a4e;
    --gang-sky: #7eb6c2;
    --gang-moss: #91a66d;
    --gang-border: #ddd7c9;

    position: relative;
    isolation: isolate;
    overflow: clip;
    color: var(--gang-ink);
  }

  .gang-page ::selection {
    background: color-mix(in srgb, var(--gang-sunshine) 72%, transparent);
    color: var(--gang-ink);
  }

  .gang-intro {
    padding-top: 8px;
  }

  .gang-breadcrumb {
    display: none;
    align-items: center;
    gap: 8px;
    color: color-mix(in srgb, var(--gang-ink) 70%, transparent);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .gang-breadcrumb a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--gang-leaf);
  }

  .gang-breadcrumb a:hover {
    color: var(--gang-ink);
  }

  .gang-breadcrumb a:focus-visible,
  .gang-member__link:focus-visible,
  .gang-empty a:focus-visible {
    outline: 3px solid var(--gang-leaf);
    outline-offset: 4px;
  }

  .gang-intro h1 {
    max-width: 11ch;
    margin: 0;
    color: var(--gang-ink);
    font-family: var(--font-display);
    font-size: var(--type-page-title);
    font-weight: 600;
    letter-spacing: var(--type-tracking-display);
    line-height: var(--type-leading-page-title);
    text-wrap: balance;
  }

  .gang-intro h1 span {
    color: var(--gang-leaf);
  }

  .gang-route {
    display: none;
  }

  .gang-grid {
    display: grid;
    gap: 64px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .gang-member {
    min-width: 0;
  }

  .gang-member__link {
    display: block;
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
    scroll-margin-bottom: calc(7rem + env(safe-area-inset-bottom));
  }

  .gang-member figure {
    margin: 0;
  }

  .gang-member__portrait {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    background: var(--gang-paper);
  }

  .gang-member--2 .gang-member__portrait,
  .gang-member--3 .gang-member__portrait {
    aspect-ratio: 4 / 5;
  }

  .gang-member__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      filter 220ms ease,
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gang-member--1 .gang-member__portrait img {
    object-position: center 40%;
  }

  .gang-member--2 .gang-member__portrait img {
    object-position: 58% center;
  }

  .gang-member--3 .gang-member__portrait img {
    object-position: center center;
  }

  .gang-member__placeholder {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 32px;
    background: var(--gang-paper);
    color: var(--gang-tomato);
    text-align: center;
  }

  .gang-member__placeholder span {
    max-width: 15rem;
    color: var(--gang-ink);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .gang-member__body {
    max-width: 38rem;
    padding-top: 20px;
  }

  .gang-member__identity {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: baseline;
  }

  .gang-member__identity h2 {
    margin: 0;
    color: var(--gang-ink);
    font-family: var(--font-display);
    font-size: var(--type-section-title);
    font-weight: 600;
    letter-spacing: var(--type-tracking-display);
    line-height: var(--type-leading-section-title);
  }

  .gang-member__identity p {
    margin: 0;
    color: var(--gang-leaf);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .gang-member__facts {
    margin: 12px 0 0;
    color: color-mix(in srgb, var(--gang-ink) 68%, transparent);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .gang-member__description {
    max-width: 65ch;
    margin: 14px 0 0;
    color: color-mix(in srgb, var(--gang-ink) 82%, transparent);
    font-size: 1rem;
    line-height: 1.65;
  }

  .gang-empty {
    max-width: 42rem;
    margin-top: 48px;
    border-block: 1px solid var(--gang-border);
    padding-block: 32px;
    color: var(--gang-tomato);
  }

  .gang-empty h2 {
    margin: 14px 0 0;
    color: var(--gang-ink);
    font-family: var(--font-display);
    font-size: var(--type-card-title);
    font-weight: 600;
    line-height: var(--type-leading-card-title);
    letter-spacing: var(--type-tracking-display);
  }

  .gang-empty p {
    margin: 12px 0 0;
    color: color-mix(in srgb, var(--gang-ink) 78%, transparent);
    line-height: 1.6;
  }

  .gang-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  .gang-empty a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border-radius: 10px;
    background: var(--gang-leaf);
    padding: 12px 18px;
    color: var(--gang-paper);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .gang-empty a + a {
    border: 1px solid var(--gang-border);
    background: var(--gang-paper);
    color: var(--gang-leaf);
  }

  @media (hover: hover) and (pointer: fine) {
    .gang-member__link:hover .gang-member__portrait img {
      filter: saturate(1.05);
      transform: scale(1.025);
    }
  }

  @media (min-width: 768px) {
    .gang-intro {
      padding-top: 16px;
    }

    .gang-breadcrumb {
      display: flex;
      margin-bottom: 24px;
    }

    .gang-intro h1 {
      font-size: var(--type-page-title);
    }

    .gang-route {
      position: absolute;
      top: 220px;
      left: 6%;
      z-index: -1;
      display: block;
      width: 88%;
      height: calc(100% - 430px);
      min-height: 940px;
      overflow: visible;
      pointer-events: none;
    }

    .gang-route path {
      fill: none;
      stroke: color-mix(in srgb, var(--gang-tomato) 42%, transparent);
      stroke-dasharray: 0.012 0.018;
      stroke-linecap: round;
      stroke-width: 3;
      vector-effect: non-scaling-stroke;
    }

    .gang-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 32px;
      row-gap: 80px;
      margin-top: 64px;
    }

    .gang-member {
      position: relative;
      z-index: 1;
    }

    .gang-member--1 {
      grid-column: 1 / span 7;
    }

    .gang-member--2 {
      grid-column: 9 / span 4;
      margin-top: 96px;
    }

    .gang-member--3 {
      grid-column: 1 / span 4;
    }

    .gang-member--4 {
      grid-column: 6 / span 7;
      margin-top: 88px;
    }

    .gang-member--1 .gang-member__body {
      margin-left: clamp(16px, 5vw, 64px);
    }

    .gang-member--2 .gang-member__body {
      padding-left: 16px;
    }

    .gang-member--4 .gang-member__body {
      margin-right: clamp(16px, 4vw, 48px);
      margin-left: auto;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .gang-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 72px 32px;
    }

    .gang-member--1,
    .gang-member--2,
    .gang-member--3,
    .gang-member--4 {
      grid-column: auto;
      margin-top: 0;
    }

    .gang-member--2,
    .gang-member--4 {
      margin-top: 64px;
    }

    .gang-member--1 .gang-member__body,
    .gang-member--2 .gang-member__body,
    .gang-member--4 .gang-member__body {
      margin-right: 0;
      margin-left: 0;
      padding-left: 0;
    }

    .gang-member__portrait,
    .gang-member--1 .gang-member__portrait,
    .gang-member--2 .gang-member__portrait,
    .gang-member--3 .gang-member__portrait,
    .gang-member--4 .gang-member__portrait {
      aspect-ratio: 4 / 5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gang-member__portrait img {
      transition: none;
    }

    .gang-member__link:hover .gang-member__portrait img {
      transform: none;
    }
  }
</style>
