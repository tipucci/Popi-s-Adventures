---
import Layout from "../layouts/Layout.astro";
import { ChevronLeft, ChevronRight, PawPrint } from "@lucide/astro";
import { getDogFriendImage, getDogFriends } from "../data/dogFriends.js";
import { withBase } from "../utils/base.js";

const dogs = (await getDogFriends()).map((dog) => ({
  ...dog,
  imageAsset: getDogFriendImage(dog.image)
}));

function formatCardNumber(index) {
  return `#${String(index + 1).padStart(3, "0")}`;
}

function getDogAgeLabel(value) {
  if (!value) return "";
  const birthDate = new Date(`${value}T00:00:00`);
  if (Number.isNaN(birthDate.getTime())) return "";

  const now = new Date();
  let years = now.getFullYear() - birthDate.getFullYear();
  const monthDelta = now.getMonth() - birthDate.getMonth();
  const dayDelta = now.getDate() - birthDate.getDate();

  if (monthDelta < 0 || (monthDelta === 0 && dayDelta < 0)) {
    years -= 1;
  }

  if (years <= 0) return "meno di 1 anno";
  return `${years} ${years === 1 ? "anno" : "anni"}`;
}
---

<Layout
  title="Gea Gang | Popi's Adventures"
  description="La piccola gang canina che accompagna le avventure di Popi's Adventures."
  active="gea-gang"
  mobileBackHref={withBase("/")}
  mobileBackLabel="Torna alla home"
>
  <section class="space-y-6">
    <section aria-labelledby="gea-gang-carousel">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p id="gea-gang-carousel" class="text-sm font-bold uppercase tracking-[0.16em] text-terracotta-600">Gea Gang</p>
          <h1 class="mt-2 text-3xl font-black text-forest-800 sm:text-4xl">La banda a quattro zampe</h1>
        </div>

        {dogs.length > 1 && (
          <div class="hidden items-center gap-2 md:flex" aria-label="Controlli carousel Gea Gang">
            <button
              type="button"
              class="dog-carousel-button inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#eadac8] bg-white/85 text-forest-800 shadow-sm transition hover:bg-[#fffaf4] focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:ring-offset-2 focus:ring-offset-[#f5ebdc]"
              data-dog-carousel-prev
              aria-label="Mostra le card precedenti"
            >
              <ChevronLeft class="h-5 w-5" stroke-width={2.2} aria-hidden="true" />
            </button>
            <button
              type="button"
              class="dog-carousel-button inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#eadac8] bg-white/85 text-forest-800 shadow-sm transition hover:bg-[#fffaf4] focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:ring-offset-2 focus:ring-offset-[#f5ebdc]"
              data-dog-carousel-next
              aria-label="Mostra le card successive"
            >
              <ChevronRight class="h-5 w-5" stroke-width={2.2} aria-hidden="true" />
            </button>
          </div>
        )}
      </div>

      <div class="-mx-4 mt-5 pb-10 sm:-mx-6 lg:-mx-8">
      <ul class="dog-carousel flex list-none gap-4 overflow-x-auto pl-4 pr-4 pb-10 pt-1 sm:pl-6 sm:pr-6 lg:pl-8 lg:pr-8" role="list">
        {dogs.map((dog, index) => (
          <li class="dog-slide shrink-0">
            <a
              href={withBase(`/gea-gang/${dog.id}`)}
              class="dog-card group flex h-full flex-col overflow-hidden rounded-[2rem] border border-[#eadac8] bg-[#fffaf4] p-3 text-left shadow-card focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:ring-offset-2 focus:ring-offset-[#f5ebdc]"
            >
              <div class="relative overflow-hidden rounded-[1.4rem] border border-white/80 bg-[#efe4d1]">
                {dog.imageAsset ? (
                  <img
                    src={dog.imageAsset.src}
                    alt={`${dog.name}, ${dog.breed}, ritratto per la scheda Gea Gang.`}
                    width={dog.imageAsset.width}
                    height={dog.imageAsset.height}
                    loading="lazy"
                    decoding="async"
                    class="h-72 w-full object-cover transition duration-500 group-hover:scale-[1.03] group-focus-visible:scale-[1.03]"
                  />
                ) : (
                  <div class="flex h-72 items-center justify-center bg-[radial-gradient(circle_at_top,_rgba(255,255,255,0.58),_transparent_55%),linear-gradient(135deg,_#efe4d1,_#e1d0b3)] text-terracotta-700">
                    <div class="flex flex-col items-center gap-3">
                      <span class="rounded-full bg-white/70 p-4 shadow-sm">
                        <PawPrint size={28} strokeWidth={2.2} aria-hidden="true" />
                      </span>
                      <p class="text-sm font-bold uppercase tracking-[0.16em]">Foto in arrivo</p>
                    </div>
                  </div>
                )}

                <div class="pointer-events-none absolute bottom-3 right-3 rounded-full bg-white/72 px-2.5 py-1 text-xs font-black text-terracotta-700 shadow-sm">
                  {formatCardNumber(index)}
                </div>
              </div>

              <div class="mt-3 flex flex-1 flex-col rounded-[1.5rem] border border-[#f1e3d2] bg-white/72 p-4">
                <div>
                  <h3 class="text-3xl font-black text-forest-800">{dog.name}</h3>
                  <p class="mt-1 text-sm font-bold text-forest-700">{dog.breed || "Razza in aggiornamento"}</p>
                </div>

                {(getDogAgeLabel(dog.birthDate) || dog.weightKg) && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {getDogAgeLabel(dog.birthDate) && (
                      <span class="rounded-full bg-[#eef4ea] px-3 py-1.5 text-xs font-bold text-forest-800">
                        {getDogAgeLabel(dog.birthDate)}
                      </span>
                    )}
                    {dog.weightKg && (
                      <span class="rounded-full bg-[#f4eadb] px-3 py-1.5 text-xs font-bold text-terracotta-700">
                        {dog.weightKg} kg
                      </span>
                    )}
                  </div>
                )}

                <p class="mt-3 line-clamp-4 text-sm leading-6 text-forest-700">{dog.description}</p>

                {dog.traits.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {dog.traits.slice(0, 3).map((trait) => (
                      <span class="rounded-full bg-[#fff1e8] px-3 py-1.5 text-xs font-bold text-[#8a4d2d]">{trait}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
      </div>
    </section>
  </section>

  <script>
    const carousel = document.querySelector(".dog-carousel");
    const previousButton = document.querySelector("[data-dog-carousel-prev]");
    const nextButton = document.querySelector("[data-dog-carousel-next]");

    function scrollDogs(direction) {
      if (!carousel) return;
      const firstSlide = carousel.querySelector(".dog-slide");
      const slideWidth = firstSlide instanceof HTMLElement ? firstSlide.offsetWidth : 360;
      carousel.scrollBy({
        left: direction * (slideWidth + 16),
        behavior: "smooth"
      });
    }

    previousButton?.addEventListener("click", () => scrollDogs(-1));
    nextButton?.addEventListener("click", () => scrollDogs(1));
  </script>
</Layout>

<style>
  .dog-carousel {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-color: rgba(138, 77, 45, 0.42) transparent;
    scrollbar-width: thin;
  }

  .dog-carousel::-webkit-scrollbar {
    height: 0.55rem;
  }

  .dog-carousel::-webkit-scrollbar-track {
    background: transparent;
  }

  .dog-carousel::-webkit-scrollbar-thumb {
    background: rgba(138, 77, 45, 0.34);
    border-radius: 999px;
  }

  .dog-slide {
    width: 82vw;
    max-width: 26rem;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .dog-card {
    transform-origin: center;
    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
    box-shadow:
      0 18px 38px rgba(95, 44, 29, 0.12),
      inset 0 0 0 1px rgba(255, 255, 255, 0.45);
  }

  .dog-card:hover,
  .dog-card:focus-visible {
    transform: translateY(-4px) scale(1.015);
    box-shadow:
      0 24px 46px rgba(95, 44, 29, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.5);
  }

  .dog-card:active {
    transform: scale(0.98);
  }

  @media (min-width: 768px) {
    .dog-slide {
      width: 24rem;
    }
  }

  @media (max-width: 767px) {
    .dog-carousel {
      scrollbar-width: none;
    }

    .dog-carousel::-webkit-scrollbar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dog-carousel {
      scroll-behavior: auto;
    }

    .dog-card,
    .dog-card:hover,
    .dog-card:focus-visible,
    .dog-card:active {
      transform: none;
      transition: none;
    }
  }
</style>
