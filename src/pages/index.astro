---
import Layout from "../layouts/Layout.astro";
import AboutUs from "../components/AboutUs.astro";
import HomeAdventureCard from "../components/HomeAdventureCard.astro";
import { getEscursioni } from "../data/escursioni.js";
import { withBase } from "../utils/base.js";
import { formatKilometers, formatMeters } from "../utils/format.js";

const escursioni = await getEscursioni();
const recenti = escursioni.slice(0, 3);
const [ultimaAvventura, ...altreRecenti] = recenti;
const hasEscursioni = escursioni.length > 0;

const stats = {
  uscite: escursioni.length,
  km: formatKilometers(escursioni.reduce((total, item) => total + item.km, 0)),
  dislivello: formatMeters(escursioni.reduce((total, item) => total + item.dislivello, 0)),
  conGea: escursioni.filter((item) => item.partecipanti.includes("gea")).length
};
const archiveHref = withBase("/escursioni");
const geaArchiveHref = `${withBase("/escursioni")}?soloGea=1`;
---

<Layout
  title="Popi's Adventures | Un diario, tre popi e un sacco di avventure"
  description="Home del diario di escursioni con ultime uscite, statistiche e storie condivise."
  active="home"
>
  <div class="home-journal">
    <section id="ultima-avventura" class="home-recent" aria-labelledby="recenti-title">
      <header class="home-recent__header">
        <h1 id="recenti-title">L'ultima avventura</h1>
      </header>

      {hasEscursioni && ultimaAvventura ? (
        <div class="home-recent__stories">
          <HomeAdventureCard escursione={ultimaAvventura} variant="featured" />

          {altreRecenti.length > 0 && (
            <section class="home-recent__more" aria-labelledby="altri-ricordi-title">
              <h2 id="altri-ricordi-title">Escursioni recenti</h2>
              <div class="home-recent__secondary">
                {altreRecenti.map((escursione) => (
                  <HomeAdventureCard escursione={escursione} />
                ))}
              </div>
            </section>
          )}

        </div>
      ) : (
        <div class="home-recent__empty">
          <p>Le ultime avventure stanno facendo un giro più lungo del previsto.</p>
          <a href={Astro.url.pathname}>Riprova</a>
        </div>
      )}
    </section>

    {hasEscursioni && (
      <section class="journal-facts" aria-labelledby="journal-facts-title">
        <div class="journal-facts__intro">
          <h2 id="journal-facts-title">Le nostre tracce</h2>
          <a class="journal-facts__archive" href={archiveHref}>
            Tutte le escursioni <span aria-hidden="true">→</span>
          </a>
        </div>
        <dl>
          <div>
            <dt>Uscite</dt>
            <dd>{stats.uscite}</dd>
          </div>
          <div class="journal-facts__gea">
            <dt>Con Gea</dt>
            <dd>
              <a href={geaArchiveHref} aria-label={`Vedi le ${stats.conGea} escursioni con Gea`}>
                {stats.conGea}
              </a>
            </dd>
          </div>
          <div>
            <dt>Km totali</dt>
            <dd>{stats.km}</dd>
          </div>
          <div>
            <dt>Dislivello</dt>
            <dd>{stats.dislivello} m</dd>
          </div>
        </dl>
      </section>
    )}

    <div class="home-about">
      <AboutUs />
    </div>
  </div>
</Layout>

<style>
  .home-journal {
    --journal-cream: #f7f1e3;
    --journal-paper: #fffdf7;
    --journal-ink: #25251f;
    --journal-leaf: #3f6b4f;
    --journal-sunshine: #f2c94c;
    --journal-tomato: #e66a4e;
    --journal-sky: #7eb6c2;
    --journal-moss: #91a66d;
    --journal-border: #ddd7c9;

    display: block;
    padding-inline: 4px;
    background: var(--journal-cream);
    box-shadow: 0 0 0 100vmax var(--journal-cream);
    clip-path: inset(0 -100vmax);
    color: var(--journal-ink);
  }

  .home-recent {
    margin-top: 28px;
    scroll-margin-top: 24px;
  }

  .home-recent__header {
    margin-bottom: 24px;
  }

  .home-recent__header h1,
  .home-recent__more h2,
  .journal-facts h2 {
    margin: 0;
    color: var(--journal-ink);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .home-recent__header h1 {
    max-width: 12ch;
    font-size: clamp(2.25rem, 9vw, 4rem);
    line-height: 0.98;
  }

  .journal-facts__archive {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    color: var(--journal-leaf);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--journal-sunshine) 85%, transparent);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .journal-facts__archive:hover {
    color: var(--journal-ink);
  }

  .journal-facts__archive:focus-visible {
    border-radius: 4px;
    outline: 3px solid var(--journal-leaf);
    outline-offset: 4px;
  }

  .home-recent__stories {
    display: grid;
    gap: 48px;
    margin-top: 0;
  }

  .home-recent__more {
    display: grid;
    gap: 20px;
    padding-top: 8px;
  }

  .home-recent__more h2 {
    font-size: 1.5rem;
    line-height: 1.08;
  }

  .home-recent__secondary {
    display: grid;
    gap: 32px;
  }

  .home-recent__empty a {
    display: inline-flex;
    width: fit-content;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    border-radius: 10px;
    background: var(--journal-leaf);
    padding: 12px 18px;
    color: var(--journal-paper);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .home-recent__empty a:hover {
    background: var(--journal-ink);
  }

  .home-recent__empty a:focus-visible {
    outline: 3px solid var(--journal-leaf);
    outline-offset: 4px;
  }

  .home-recent__empty {
    margin-top: 24px;
    border: 1px solid var(--journal-border);
    border-radius: 10px;
    background: var(--journal-paper);
    padding: 24px;
  }

  .home-recent__empty p {
    max-width: 42rem;
    margin: 0 0 16px;
    line-height: 1.6;
  }

  .journal-facts {
    display: grid;
    gap: 24px;
    margin-top: 32px;
    border-block: 1px solid var(--journal-border);
    padding-block: 24px;
  }

  .journal-facts__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 20px;
  }

  .home-about {
    margin-top: 64px;
  }

  .journal-facts h2 {
    font-size: 1.5rem;
    line-height: 1.08;
  }

  .journal-facts dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 24px;
    margin: 0;
  }

  .journal-facts dl > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    min-width: 0;
  }

  .journal-facts dt,
  .journal-facts dd {
    margin: 0;
  }

  .journal-facts dt {
    color: color-mix(in srgb, var(--journal-ink) 66%, transparent);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .journal-facts dd {
    color: var(--journal-ink);
    font-size: 1.125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .journal-facts__gea dd {
    width: fit-content;
    background: linear-gradient(
      transparent 56%,
      color-mix(in srgb, var(--journal-sunshine) 70%, transparent) 56%
    );
  }

  .journal-facts__gea {
    position: relative;
    border-radius: 6px;
  }

  .journal-facts__gea a {
    color: inherit;
    text-decoration: none;
  }

  .journal-facts__gea a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .journal-facts__gea:hover dt,
  .journal-facts__gea:focus-within dt {
    color: var(--journal-leaf);
  }

  .journal-facts__gea:focus-within {
    outline: 3px solid var(--journal-leaf);
    outline-offset: 4px;
  }

  .journal-facts__gea a:focus-visible {
    outline: none;
  }

  @media (min-width: 640px) {
    .home-journal {
      padding-inline: 0;
    }

    .home-recent {
      margin-top: 40px;
    }

    .home-recent__header {
      margin-bottom: 32px;
    }

    .home-recent__secondary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .journal-facts {
      grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 2fr);
      align-items: center;
      margin-top: 48px;
    }

    .journal-facts dl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .home-about {
      margin-top: 96px;
    }
  }
</style>



