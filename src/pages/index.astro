---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import AboutUs from "../components/AboutUs.astro";
import HomeAdventureCard from "../components/HomeAdventureCard.astro";
import { getEscursioni } from "../data/escursioni.js";
import { siteImages } from "../data/imageRegistry.js";
import heroHome from "../assets/images/site/home/popi-hero-editorial.png";
import heroHomeMobile from "../assets/images/site/home/popi-hero-editorial-mobile.png";
import { withBase } from "../utils/base.js";
import { formatKilometers, formatMeters } from "../utils/format.js";

const escursioni = await getEscursioni();
const recenti = escursioni.slice(0, 3);
const [ultimaAvventura, ...altreRecenti] = recenti;
const hasEscursioni = escursioni.length > 0;
const [heroPreloadMobile, heroPreloadDesktop] = await Promise.all([
  getImage({ src: heroHomeMobile, width: 900, format: "webp", quality: 72 }),
  getImage({ src: heroHome, width: 1440, format: "webp", quality: 78 })
]);


const stats = {
  uscite: escursioni.length,
  km: formatKilometers(escursioni.reduce((total, item) => total + item.km, 0)),
  dislivello: formatMeters(escursioni.reduce((total, item) => total + item.dislivello, 0)),
  conGea: escursioni.filter((item) => item.partecipanti.includes("gea")).length
};
const geaArchiveHref = `${withBase("/escursioni")}?soloGea=1`;
---

<Layout
  title="Popi's Adventures | Un diario, tre popi e un sacco di avventure"
  description="Home del diario di escursioni con ultime uscite, statistiche e storie condivise."
  active="home"
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={heroPreloadDesktop.src}
      imagesrcset={`${heroPreloadMobile.src} ${heroPreloadMobile.width}w, ${heroPreloadDesktop.src} ${heroPreloadDesktop.width}w`}
      imagesizes="100vw"
      fetchpriority="high"
    />
  </Fragment>
  <div class="home-journal">
    <Header
      imageMobile={heroHomeMobile}
      imageDesktop={heroHome}
      imageAlt="Tizi, Meg e Gea insieme in un prato di montagna al tramonto."
    />

    <section id="ultima-avventura" class="home-recent" aria-labelledby="recenti-title">
      <h2 id="recenti-title" class="home-recent__title--sr">Le avventure più recenti</h2>

      {hasEscursioni && ultimaAvventura ? (
        <div class="home-recent__stories">
          <HomeAdventureCard escursione={ultimaAvventura} variant="featured" />

          {altreRecenti.length > 0 && (
            <div class="home-recent__secondary">
              {altreRecenti.map((escursione) => (
                <HomeAdventureCard escursione={escursione} />
              ))}
            </div>
          )}

        </div>
      ) : (
        <div class="home-recent__empty">
          <p>Le ultime avventure stanno facendo un giro più lungo del previsto.</p>
          <a href={Astro.url.pathname}>Riprova</a>
        </div>
      )}
    </section>

    {hasEscursioni && (
      <section class="journal-facts" aria-labelledby="journal-facts-title">
        <h2 id="journal-facts-title">Le nostre tracce</h2>
        <dl>
          <div>
            <dt>Uscite</dt>
            <dd>{stats.uscite}</dd>
          </div>
          <div class="journal-facts__gea">
            <dt>Con Gea</dt>
            <dd>
              <a href={geaArchiveHref} aria-label={`Vedi le ${stats.conGea} escursioni con Gea`}>
                {stats.conGea}
              </a>
            </dd>
          </div>
          <div>
            <dt>Km totali</dt>
            <dd>{stats.km}</dd>
          </div>
          <div>
            <dt>Dislivello</dt>
            <dd>{stats.dislivello} m</dd>
          </div>
        </dl>
      </section>
    )}

    <div class="home-about">
      <AboutUs />
    </div>
  </div>
</Layout>

<style>
  .home-journal {
    --journal-cream: #f7f1e3;
    --journal-paper: #fffdf7;
    --journal-ink: #25251f;
    --journal-leaf: #3f6b4f;
    --journal-sunshine: #f2c94c;
    --journal-tomato: #e66a4e;
    --journal-sky: #7eb6c2;
    --journal-moss: #91a66d;
    --journal-border: #ddd7c9;

    display: block;
    padding-inline: 4px;
    background: var(--journal-cream);
    box-shadow: 0 0 0 100vmax var(--journal-cream);
    clip-path: inset(0 -100vmax);
    color: var(--journal-ink);
  }

  .home-recent {
    margin-top: 48px;
    scroll-margin-top: 24px;
  }

  .journal-facts h2 {
    margin: 0;
    color: var(--journal-ink);
    font-family: "Nunito", ui-sans-serif, system-ui, sans-serif;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .home-recent__title--sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .home-recent__stories {
    display: grid;
    gap: 32px;
    margin-top: 0;
  }

  .home-recent__secondary {
    display: grid;
    gap: 32px;
    margin-top: 8px;
  }

  .home-recent__empty a {
    display: inline-flex;
    width: fit-content;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    border-radius: 10px;
    background: var(--journal-leaf);
    padding: 12px 18px;
    color: var(--journal-paper);
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .home-recent__empty a:hover {
    background: var(--journal-ink);
  }

  .home-recent__empty a:focus-visible {
    outline: 3px solid var(--journal-leaf);
    outline-offset: 4px;
  }

  .home-recent__empty {
    margin-top: 24px;
    border: 1px solid var(--journal-border);
    border-radius: 10px;
    background: var(--journal-paper);
    padding: 24px;
  }

  .home-recent__empty p {
    max-width: 42rem;
    margin: 0 0 16px;
    line-height: 1.7;
  }

  .journal-facts {
    display: grid;
    gap: 24px;
    margin-top: 32px;
    border-block: 1px solid var(--journal-border);
    padding-block: 24px;
  }

  .home-about {
    margin-top: 64px;
  }

  .journal-facts h2 {
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .journal-facts dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 24px;
    margin: 0;
  }

  .journal-facts dl > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    min-width: 0;
  }

  .journal-facts dt,
  .journal-facts dd {
    margin: 0;
  }

  .journal-facts dt {
    color: color-mix(in srgb, var(--journal-ink) 66%, transparent);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .journal-facts dd {
    color: var(--journal-ink);
    font-size: 1.125rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .journal-facts__gea dd {
    width: fit-content;
    background: linear-gradient(
      transparent 56%,
      color-mix(in srgb, var(--journal-sunshine) 70%, transparent) 56%
    );
  }

  .journal-facts__gea {
    position: relative;
    border-radius: 6px;
  }

  .journal-facts__gea a {
    color: inherit;
    text-decoration: none;
  }

  .journal-facts__gea a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .journal-facts__gea:hover dt,
  .journal-facts__gea:focus-within dt {
    color: var(--journal-leaf);
  }

  .journal-facts__gea:focus-within {
    outline: 3px solid var(--journal-leaf);
    outline-offset: 4px;
  }

  .journal-facts__gea a:focus-visible {
    outline: none;
  }

  @media (min-width: 640px) {
    .home-journal {
      padding-inline: 0;
    }

    .home-recent {
      margin-top: 64px;
    }

    .home-recent__secondary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 16px;
    }

    .journal-facts {
      grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 2fr);
      align-items: center;
      margin-top: 48px;
    }

    .journal-facts dl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .home-about {
      margin-top: 96px;
    }
  }
</style>



